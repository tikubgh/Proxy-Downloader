        def fetch_part(p_idx):
            p_start, p_end = start + p_idx * part_size, min(start + p_idx * part_size + part_size - 1, end)
            if p_start > end: return b''
            h = self.headers.copy(); h['Range'] = f'bytes={p_start}-{p_end}'
