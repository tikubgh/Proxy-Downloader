          if db[fid]['status'] == 'Stopped': stop_event.set(); break
      
      while submitted < min(curr_idx + 32, total_chunks):
          executor.submit(fetch, submitted)
          submitted += 1
          
      with cv:
          while curr_idx not in buffer and not stop_event.is_set(): cv.wait(0.5)
              
      if stop_event.is_set(): break
      data = buffer.pop(curr_idx)
      if data == b'ERR': raise Exception("Source server disconnected mid-swarm.")
      
