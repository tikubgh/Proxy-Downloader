@app.route('/api/media_info/<fid>')
def media_info(fid):
    try:
        target_url = request.args.get('url')
        input_target = resolve_target(target_url, fid)
        if not input_target:
            return jsonify({'audio': [], 'subs': []})
        http_opts = []
        if input_target.startswith('http'):
            http_opts.extend(['-user_agent', SPOOF_AGENT, '-reconnect', '1', '-reconnect_streamed', '1', '-reconnect_delay_max', '5'])
        
        cmd = ['ffprobe', '-v', 'error']
        cmd.extend(http_opts)
        cmd.extend(['-show_entries', 'stream=index,codec_type:stream_tags=language,title', '-of', 'json', input_target])
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
        data = json.loads(res.stdout)
        auds = []
        subs = []
        a_idx = 0
        s_idx = 0
        
        for stream in data.get('streams', []):
            tags = stream.get('tags', {})
            if stream.get('codec_type') == 'audio':
                lang = tags.get('language', 'und')
                title = tags.get('title', f'Audio Track {a_idx+1}')
                auds.append({'index': a_idx, 'lang': lang, 'title': title})
                a_idx += 1
            elif stream.get('codec_type') == 'subtitle':
                lang = tags.get('language', 'und')
                title = tags.get('title', f'Subtitle Track {s_idx+1}')
                subs.append({'index': s_idx, 'lang': lang, 'title': title})
                s_idx += 1
        return jsonify({'audio': auds, 'subs': subs})
    except Exception as e:
        return jsonify({'error': str(e)}), 500

@app.route('/api/start_hls')
def start_hls():
    try:
        target_url = request.args.get('url')
        session_cb = request.args.get('cb', str(time.time()))
        audio_idx = request.args.get('audio_idx', '0')
        sub_idx = request.args.get('sub_idx', 'none')
        fid = request.args.get('fid', 'none')
        
        if not target_url:
            return jsonify({'error': 'No URL provided.'}), 400
            
        stream_id = hashlib.md5(f"{target_url}_{session_cb}_{audio_idx}_{sub_idx}".encode()).hexdigest()
        stream_dir = os.path.join(HLS_DIR, stream_id)
        
        if fid != 'none' and fid != 'null':
            if str(fid).startswith('mount_'):
                with db_lock:
                    active_mount_streams.add(stream_id)
            else:
                with db_lock:
                    if fid in db:
                        if 'hls_streams' not in db[fid]:
                            db[fid]['hls_streams'] = set()
                        db[fid]['hls_streams'].add(stream_id)
                        
        input_target = resolve_target(target_url)
        if not input_target:
            return jsonify({'error': 'Failed to resolve streaming target.'}), 500
            
        http_opts = []
        if input_target.startswith('http'):
            http_opts.extend(['-user_agent', SPOOF_AGENT, '-reconnect', '1', '-reconnect_streamed', '1', '-reconnect_delay_max', '5'])
            
        cmd_probe_v = ['ffprobe', '-v', 'error']
        cmd_probe_v.extend(http_opts)
        cmd_probe_v.extend(['-select_streams', 'v:0', '-show_entries', 'stream=codec_name', '-of', 'default=noprint_wrappers=1:nokey=1', input_target])
        
        try:
            v_codec = subprocess.check_output(cmd_probe_v, timeout=10).decode().strip().lower()
        except:
            v_codec = "unknown"
            
        cmd_probe_a = ['ffprobe', '-v', 'error']
        cmd_probe_a.extend(http_opts)
        cmd_probe_a.extend(['-select_streams', f'a:{audio_idx}', '-show_entries', 'stream=codec_name', '-of', 'default=noprint_wrappers=1:nokey=1', input_target])
        
        try:
            a_codec = subprocess.check_output(cmd_probe_a, timeout=10).decode().strip().lower()
        except:
            a_codec = "unknown"
            
        s_codec = "none"
        if sub_idx != 'none':
            try:
                cmd_probe_s = ['ffprobe', '-v', 'error']
                cmd_probe_s.extend(http_opts)
                cmd_probe_s.extend(['-select_streams', f's:{sub_idx}', '-show_entries', 'stream=codec_name', '-of', 'default=noprint_wrappers=1:nokey=1', input_target])
                s_codec = subprocess.check_output(cmd_probe_s, timeout=10).decode().strip().lower()
            except:
                s_codec = "unknown"
                
        bitmap_subs = ['dvd_subtitle', 'hdmv_pgs_subtitle', 'pgssub', 'dvdsub', 'xsub']
        is_bitmap_sub = s_codec in bitmap_subs
        vcodec_args = ['-c:v', 'copy']
        
        if v_codec in ['hevc', 'h265']:
            vcodec_args = ['-c:v', 'copy', '-tag:v', 'hvc1']
        elif v_codec not in ['h264', 'avc']:
            vcodec_args = ['-c:v', 'libx264', '-preset', 'ultrafast', '-crf', '23']
            
        if a_codec in ['aac', 'mp3', 'ac3']:
            acodec_args = ['-c:a', 'copy']
        else:
            acodec_args = ['-c:a', 'aac', '-ac', '2', '-b:a', '192k', '-ar', '48000']
            
        maps = ['-map', '0:v:0?', '-map', f'0:a:{audio_idx}?']
        extra_args = []
        
        if sub_idx != 'none':
            if is_bitmap_sub:
                vcodec_args = ['-c:v', 'libx264', '-preset', 'ultrafast', '-crf', '23']
                extra_args.extend(['-filter_complex', f'[0:v:0][0:s:{sub_idx}]overlay=format=yuv420p[vout]'])
                maps = ['-map', '[vout]', '-map', f'0:a:{audio_idx}?']
                extra_args.extend(['-sn'])
            else:
                maps.extend(['-map', f'0:s:{sub_idx}?'])
                extra_args.extend(['-c:s', 'webvtt'])
        else:
            extra_args.extend(['-sn'])
            
        if stream_id not in hls_procs or hls_procs[stream_id].poll() is not None:
            os.makedirs(stream_dir, exist_ok=True)
            for f in os.listdir(stream_dir):
                try:
                    os.remove(os.path.join(stream_dir, f))
                except:
                    pass
            log_path = os.path.join(stream_dir, 'ffmpeg.log')
            log_fd = open(log_path, 'w')
            cmd = ['ffmpeg', '-hide_banner', '-loglevel', 'warning']
            cmd.extend(http_opts)
            cmd.extend(['-fflags', '+genpts+discardcorrupt', '-threads', '0', '-i', input_target])
            cmd.extend(extra_args if is_bitmap_sub else [])
            cmd.extend(maps)
            cmd.extend(vcodec_args)
            cmd.extend(acodec_args)
            cmd.extend(extra_args if not is_bitmap_sub else [])
            cmd.extend(['-start_at_zero', '-avoid_negative_ts', 'make_zero', '-max_muxing_queue_size', '9999', '-f', 'hls', '-hls_time', '4', '-hls_segment_type', 'mpegts', '-hls_flags', 'independent_segments+delete_segments', '-hls_list_size', '6', '-hls_playlist_type', 'event', '-master_pl_name', 'master.m3u8', os.path.join(stream_dir, 'index.m3u8')])
            
            try:
                hls_procs[stream_id] = subprocess.Popen(cmd, stderr=log_fd)
            except Exception as e:
                return jsonify({'error': f'Backend Failure: {str(e)}'}), 500
                
            for _ in range(150):
                if os.path.exists(os.path.join(stream_dir, 'master.m3u8')) and os.path.exists(os.path.join(stream_dir, 'index.m3u8')):
                    break
                ret = hls_procs[stream_id].poll()
                if ret is not None:
                    log_fd.close()
                    err_msg = "Unknown Error"
                    if os.path.exists(log_path):
                        with open(log_path, 'r') as f:
                            err_msg = f.read()[-400:].replace('\n', ' | ')
                    return jsonify({'error': f'FFmpeg Core Crash (Exit {ret}). Reason: {err_msg}'}), 500
                time.sleep(0.1)
                
            if not os.path.exists(os.path.join(stream_dir, 'master.m3u8')):
                return jsonify({'error': 'FFmpeg Initialization Timeout. Stream could not be processed.'}), 500
                
        return jsonify({'playlist_url': f'/hls/{stream_id}/master.m3u8', 'stream_id': stream_id, 'transcoded': is_bitmap_sub or v_codec not in ['h264', 'avc', 'hevc', 'h265']})
    except Exception as e:
        return jsonify({'error': f'Unhandled Exception: {str(e)}'}), 500

