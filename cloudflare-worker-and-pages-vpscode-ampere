async function initUpload(type){
    let fi=document.getElementById('file_'+type); let f=fi.files[0];
    if(!f) return alert("Select a file first!");
    let r=await fetch('/api/upload_init', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({type:type, name:f.name, size:f.size})});
    let d=await r.json(); fi.value='';
    
    if (type === 'p2p' || type === 'disk_relay') { checkP2PWait(d.fid, f); } 
}

async function checkP2PWait(fid, file) {
    let connected = false;
    while (!connected) {
        try {
            let res = await fetch('/api/p2p_wait/'+fid);
            let data = await res.json();
            if (data.status === 'Stopped') return;
            if (data.connected) {
                connected = true;
                startGbpsP2P(fid, file);
            } else { await new Promise(r => setTimeout(r, 1000)); }
        } catch(e) { await new Promise(r => setTimeout(r, 1000)); }
    }
}

async function startGbpsP2P(fid, file) {
    let concurrencyLimit = 16; 
    let activeUploads = new Set();
    let running = true;
    let P2P_CHUNK_SIZE = 1048576; 

    let loop = setInterval(async () => {
        if(!running) { clearInterval(loop); return; }
        if(activeUploads.size >= concurrencyLimit) return;
        
        try {
            let res = await fetch(`/api/p2p_poll/${fid}`);
            if (!res.ok) { running = false; clearInterval(loop); return; }
            let needed = await res.json();
            
            if (needed.length === 0 && activeUploads.size === 0) {
                let chk = await fetch('/api/data'); let js = await chk.json();
                let fObj = js.files.find(x => x.id === fid);
                if (!fObj || fObj.status === 'Completed' || fObj.status === 'Stopped') {
                    running = false; clearInterval(loop); return;
                }
            }

            for(let idx of needed) {
                if(!activeUploads.has(idx) && activeUploads.size < concurrencyLimit) {
                    activeUploads.add(idx);
                    uploadP2PChunk(fid, file, idx, P2P_CHUNK_SIZE).finally(() => { activeUploads.delete(idx); });
                }
            }
        } catch(e) {}
    }, 150); 
}

async function uploadP2PChunk(fid, file, idx, chunkSize) {
    let start = idx * chunkSize;
    let end = Math.min(start + chunkSize, file.size);
    if(start >= file.size) return;
    
    let chunk = file.slice(start, end);
    try {
        await fetch(`/api/p2p_up/${fid}/${idx}`, {
            method: 'POST',
            headers: {'Content-Type': 'application/octet-stream'},
            body: chunk
        });
    } catch(e) {}
}

