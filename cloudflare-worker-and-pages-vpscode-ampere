def drive_worker(fid, swarm=False):
    with db_lock:
        if fid not in db: return
        u = db[fid]['url']; db[fid]['status'] = 'Swarm Piping to Drive...' if swarm else 'Piping to Drive...'
        p = db[fid]['path']
    try:
        try: from curl_cffi import requests as creq; rqk = {"impersonate": "chrome"}
        except: creq, rqk = requests, {}
        
        token, err = get_drive_auth()
        if err: raise Exception(err)
        
        r = creq.get(u, headers=HEADERS, stream=True, timeout=15, allow_redirects=True, **rqk)
        update_file_metadata(fid, r)
        tot = int(r.headers.get('content-length', 0))
        sr = r.headers.get('accept-ranges') == 'bytes' or r.headers.get('Content-Range')
        
        if tot == 0:
            try: tot = int(creq.head(u, headers=HEADERS, timeout=10, allow_redirects=True, **rqk).headers.get('content-length', 0))
            except: pass
            
        with db_lock: db[fid]['total'], nm = tot, db[fid]['name']
        mt = mimetypes.guess_type(nm)[0] or 'application/octet-stream'
        
        ir = drive_api_session.post('https://www.googleapis.com/upload/drive/v3/files?uploadType=resumable', headers={'Authorization': f'Bearer {token}', 'Content-Type': 'application/json', 'X-Upload-Content-Type': mt}, json={'name': nm}, timeout=30)
        ir.raise_for_status(); uu = ir.headers['Location']
        
        def up_chk(db_bytes, st_byte, is_final=False):
            cl = len(db_bytes)
            tot_str = str(tot) if tot > 0 else (str(st_byte + cl) if is_final else '*')
            hdrs = {'Content-Range': f'bytes {st_byte}-{st_byte + cl - 1}/{tot_str}', 'Content-Length': str(cl)}
            for _ in range(5):
                try:
                    rs = drive_api_session.put(uu, data=db_bytes, headers=hdrs, timeout=120)
                    if rs.status_code in [308, 200, 201]:
                        fid_out = rs.json().get('id') if rs.status_code in [200, 201] else None
                        return True, fid_out
                except: time.sleep(2)
            return False, None

        if not swarm or not sr or tot == 0:
            cz, sb, fi, buf = 33554432, 0, None, bytearray()
            iter_chunks = r.iter_content(4194304) if hasattr(r, 'iter_content') else r.raw.read
            for ck in iter_chunks:
                with db_lock:
                    if db[fid].get('status') == 'Stopped': r.close(); raise Exception("Stopped")
                if ck:
                    buf.extend(ck)
                    with db_lock: db[fid]['down'] += len(ck)
                    while len(buf) >= cz:
                        cd = bytes(buf[:cz]); del buf[:cz]
                        suc, fi = up_chk(cd, sb, is_final=False)
                        if not suc: raise Exception("Upload rejected.")
                        sb += cz
            if buf or sb == 0:
                suc, fi = up_chk(bytes(buf), sb, is_final=True)
                if not suc: raise Exception("Final chunk rejected.")
            r.close()
            with db_lock: db[fid]['status'], db[fid]['type'], db[fid]['file_id'] = 'Completed', 'drive_direct', fi
            return

        r.close()
        
        # SWARM TO DRIVE (1. DL to Disk via Hyper-Thread -> 2. Sequential UP to Drive)
        with db_lock: db[fid]['status'] = 'Swarming to Buffer Disk...'
        worker_core(fid, 'multi')
        
        with db_lock:
            if db[fid].get('status') != 'Completed': raise Exception("Buffer Download Failed.")
            db[fid]['status'] = 'Piping Buffer to Drive...'
            db[fid]['down'] = 0
            
        with open(p, 'rb') as f:
            cz, sb, fi = 67108864, 0, None
            while sb < tot:
                with db_lock:
                    if db[fid].get('status') == 'Stopped': raise Exception("Stopped")
                cd = f.read(min(cz, tot - sb))
                if not cd: break
                is_final = (sb + len(cd) >= tot)
                suc, fi = up_chk(cd, sb, is_final=is_final)
                if not suc: raise Exception("Upload rejected.")
                sb += len(cd)
                with db_lock: db[fid]['down'] = sb
                
        os.remove(p)
        with db_lock: db[fid]['status'], db[fid]['type'], db[fid]['file_id'] = 'Completed', 'drive_direct', fi

    except Exception as e:
        with db_lock: db[fid]['status'] = f'Error: {str(e)[:40]}' if fid in db else ""

