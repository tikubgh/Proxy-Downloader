def build_archive_data(rf, file_id=None, a_type='direct', url=None):
    global global_mounted_data
    if rf.size == 0: raise Exception("No Content-Length.")
    n = urllib.parse.unquote(os.path.basename(urllib.parse.urlparse(rf.url).path)).lower() if not file_id else '.zip'
    fs, mid = [], f"mount_{str(uuid.uuid4())[:8]}"
    bu = file_id if file_id else base64.urlsafe_b64encode(url.encode()).decode()
    b_pth = f"/{a_type}_archive_dl/{bu}"
    def _add(nm, sz): fs.append({'name': nm, 'size': sz, 'b64': base64.urlsafe_b64encode(nm.encode()).decode(), 'url': f"{b_pth}/{base64.urlsafe_b64encode(nm.encode()).decode()}/{urllib.parse.quote(os.path.basename(nm))}"})
    if n.endswith('.zip') or not any(n.endswith(x) for x in ['.rar','.7z','.tar','.gz','.bz2','.xz','.lz']):
        with zipfile.ZipFile(rf) as zf:
            for i in zf.infolist():
                if not i.is_dir(): _add(i.filename, i.file_size)
    elif n.endswith('.rar') and rarfile:
        with rarfile.RarFile(rf) as rr:
            for i in rr.infolist():
                if not i.isdir(): _add(i.filename, i.file_size)
    elif n.endswith('.7z') and py7zr:
        with py7zr.SevenZipFile(rf, mode='r') as sz:
            for i in sz.list():
                if not i.is_directory: _add(i.filename, i.uncompressed)
    else: raise Exception("Unsupported format.")
    mount_info = {'files': fs, 'type': a_type, 'mount_id': mid, 'bu': bu, 'created_at': time.time()}
    with archive_mounts_lock:
        archive_mounts_cache[bu] = mount_info
    global_mounted_data = mount_info
    return global_mounted_data

