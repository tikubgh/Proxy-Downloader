@app.route('/api/start_hls')
def start_hls():
    try:
        t, cb, ai, si, fid = request.args.get('url'), request.args.get('cb', str(time.time())), request.args.get('audio_idx', '0'), request.args.get('sub_idx', 'none'), request.args.get('fid', 'none')
        sid = hashlib.md5(f"{fid}_{cb}_{ai}_{si}".encode()).hexdigest(); sdir = os.path.join(HLS_DIR, sid)
        if fid != 'none' and fid != 'null':
            with db_lock:
                if fid in db:
                    if 'hls_streams' not in db[fid]: db[fid]['hls_streams'] = set()
                    db[fid]['hls_streams'].add(sid)
        
        def _prob(x):
            try: return subprocess.check_output(['ffprobe', '-v', 'error', '-select_streams', x, '-show_entries', 'stream=codec_name', '-of', 'default=noprint_wrappers=1:nokey=1', t], timeout=10).decode().strip().lower()
            except: return "unknown"
            
        vc, ac, sc = _prob('v:0'), _prob(f'a:{ai}'), _prob(f's:{si}') if si != 'none' else 'none'
        ibs = sc in ['dvd_subtitle', 'hdmv_pgs_subtitle', 'pgssub', 'dvdsub', 'xsub']
        vca = ['-c:v', 'copy', '-tag:v', 'hvc1'] if vc in ['hevc', 'h265'] else (['-c:v', 'copy'] if vc in ['h264', 'avc'] else ['-c:v', 'libx264', '-preset', 'ultrafast', '-crf', '23'])
        aca = ['-c:a', 'copy'] if ac in ['aac', 'mp3', 'ac3'] else ['-c:a', 'aac', '-ac', '2', '-b:a', '192k', '-ar', '48000']
        mps, ea = ['-map', '0:v:0?', '-map', f'0:a:{ai}?'], []
        if si != 'none':
            if ibs: vca = ['-c:v', 'libx264', '-preset', 'ultrafast', '-crf', '23']; ea.extend(['-filter_complex', f'[0:v:0][0:s:{si}]overlay=format=yuv420p[vout]', '-sn']); mps = ['-map', '[vout]', '-map', f'0:a:{ai}?']
            else: mps.extend(['-map', f'0:s:{si}?']); ea.extend(['-c:s', 'webvtt'])
        else: ea.extend(['-sn'])
        if sid not in hls_procs or hls_procs[sid].poll() is not None:
            os.makedirs(sdir, exist_ok=True); [os.remove(os.path.join(sdir, f)) for f in os.listdir(sdir)]
            cmd = ['ffmpeg', '-hide_banner', '-loglevel', 'warning', '-fflags', '+genpts+discardcorrupt', '-i', t] + (ea if ibs else []) + mps + vca + aca + (ea if not ibs else []) + ['-f', 'hls', '-hls_time', '4', '-hls_list_size', '6', '-master_pl_name', 'master.m3u8', os.path.join(sdir, 'index.m3u8')]
            hls_procs[sid] = subprocess.Popen(cmd, stderr=open(os.path.join(sdir, 'ffmpeg.log'), 'w'))
            for _ in range(150):
                if os.path.exists(os.path.join(sdir, 'master.m3u8')): break
                if hls_procs[sid].poll() is not None: return jsonify({'error': 'FFmpeg Crash'}), 500
                time.sleep(0.1)
        return jsonify({'playlist_url': f'/hls/{sid}/master.m3u8', 'stream_id': sid, 'transcoded': ibs or vc not in ['h264', 'avc', 'hevc', 'h265']})
    except Exception as e: return jsonify({'error': str(e)}), 500

