def stream_extracted_file(f, start_byte, length_to_send, fid):
    try:
        if hasattr(f, 'seek') and callable(getattr(f, 'seek', None)): f.seek(start_byte)
        else: raise Exception("No Seek")
    except Exception:
        skipped = 0
        while skipped < start_byte:
            with db_lock:
                if fid not in db or db[fid]['status'] == 'Stopped': return
            to_read = min(4194304, start_byte - skipped)
            chunk = f.read(to_read)
            if not chunk: break
            skipped += len(chunk)
    sent = 0
    while sent < length_to_send:
        with db_lock:
            if fid not in db or db[fid]['status'] == 'Stopped': break
        to_read = min(1048576, length_to_send - sent)
        chunk = f.read(to_read)
        if not chunk: break
        with db_lock: db[fid]['down'] += len(chunk)
        sent += len(chunk)
        yield chunk

@app.route('/direct_archive_dl/<b64_url>/<b64_name>/<path:filename>', methods=['GET', 'HEAD'])
def direct_archive_dl(b64_url, b64_name, filename):
    try:
        url = base64.urlsafe_b64decode(b64_url.encode('utf-8')).decode('utf-8')
        ext = request.args.get('ext', 'zip')
        file_size = int(request.args.get('sz', 0))
        internal_filename = base64.urlsafe_b64decode(b64_name.encode('utf-8')).decode('utf-8')
        mt = mimetypes.guess_type(filename)[0] or 'application/octet-stream'
        encoded_name = urllib.parse.quote(os.path.basename(internal_filename))
        
        if request.method == 'HEAD':
            hdrs = {'Content-Type': mt, 'Accept-Ranges': 'bytes', 'Content-Disposition': f"attachment; filename*=UTF-8''{encoded_name}"}
            if file_size > 0: hdrs['Content-Length'] = str(file_size)
            return Response(status=200, headers=hdrs)
            
        hrf = HttpRangeFile(url)
        rh = request.headers.get('Range')
        start_byte = 0
        end_byte = file_size - 1 if file_size > 0 else 0
        is_range = False
        if rh and file_size > 0:
            m = re.search(r'bytes=(\d+)-(\d*)', rh)
            if m:
                start_byte = int(m.group(1))
                if m.group(2): end_byte = int(m.group(2))
                is_range = True
        length_to_send = end_byte - start_byte + 1 if file_size > 0 else 0
        fid = hashlib.md5(f"direct_archive_{url}_{b64_name}".encode()).hexdigest()[:8]
        with db_lock:
            if fid not in db: db[fid] = {'id': fid, 'name': os.path.basename(internal_filename), 'status': 'Piping from Direct HTTP LRU RAM...', 'down': 0, 'total': file_size, 'type': 'archive_pipe', 'start': time.time(), 'url': ''}
            else: db[fid]['status'] = 'Piping from Direct HTTP LRU RAM...'

        def generate_zip():
            try:
                with zipfile.ZipFile(hrf) as zf:
                    with zf.open(internal_filename) as f: yield from stream_extracted_file(f, start_byte, length_to_send, fid)
            except Exception as e: pass
        def generate_rar():
            try:
                with rarfile.RarFile(hrf) as rf:
                    with rf.open(internal_filename) as f: yield from stream_extracted_file(f, start_byte, length_to_send, fid)
            except Exception as e: pass
        def generate_7z():
            try:
                with py7zr.SevenZipFile(hrf, mode='r') as szf:
                    f = szf.read([internal_filename])[internal_filename]
                    yield from stream_extracted_file(f, start_byte, length_to_send, fid)
            except Exception as e: pass
        def generate_tar():
            try:
                mode = ext.replace('_', ':')
                with tarfile.open(fileobj=hrf, mode=mode) as tf:
                    f = tf.extractfile(internal_filename)
                    if not f: return
                    yield from stream_extracted_file(f, start_byte, length_to_send, fid)
            except Exception as e: pass

        hdrs = {'Content-Type': mt, 'Content-Disposition': f"attachment; filename*=UTF-8''{encoded_name}", 'Accept-Ranges': 'bytes', 'Cache-Control': 'no-store', 'Access-Control-Allow-Origin': '*'}
        if file_size > 0:
            hdrs['Content-Length'] = str(length_to_send)
            if is_range: hdrs['Content-Range'] = f'bytes {start_byte}-{end_byte}/{file_size}'
        if ext == 'zip': return Response(generate_zip(), status=206 if is_range else 200, headers=hdrs)
        elif ext == 'rar': return Response(generate_rar(), status=206 if is_range else 200, headers=hdrs)
        elif ext == '7z': return Response(generate_7z(), status=206 if is_range else 200, headers=hdrs)
        else: return Response(generate_tar(), status=206 if is_range else 200, headers=hdrs)
    except Exception as e: return str(e), 500

