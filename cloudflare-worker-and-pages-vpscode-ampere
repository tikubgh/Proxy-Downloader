@app.route('/gofile_stream/<file_id>/<path:fname>', methods=['GET', 'HEAD'])
def gofile_stream(file_id, fname):
    with gofile_cache_lock:
        entry = gofile_files_cache.get(file_id)
    if not entry: return "File not found in cache. Please reload folder.", 404
    
    dlink = None
    if isinstance(entry, dict) and entry.get('type') == 'folder_file':
        now = time.time()
        # Refresh Gofile link if it is older than 15 minutes (900 seconds)
        if now - entry.get('updated_at', 0) > 900:
            content_id = entry['content_id']
            gofile_fid = entry['gofile_fid']
            try:
                t, is_guest = get_active_gofile_token()
                if t:
                    headers = {
                        'User-Agent': SPOOF_AGENT,
                        'Authorization': f'Bearer {t}',
                        'X-Website-Token': generate_website_token(t, SPOOF_AGENT)
                    }
                    r = gofile_api_request("GET", f'https://api.gofile.io/contents/{content_id}', headers=headers)
                    res = r.json()
                    if res.get('status') == 'ok':
                        contents = res.get('data', {}).get('contents', {})
                        f = contents.get(gofile_fid, {})
                        new_dlink = f.get('link') or f.get('directLink')
                        if new_dlink:
                            with gofile_cache_lock:
                                # Refresh cache for all files in this response to prevent redundant API hits
                                for fid, item in contents.items():
                                    if item.get('type') == 'file':
                                        dl = item.get('link') or item.get('directLink')
                                        if dl:
                                            gofile_files_cache[fid] = {
                                                'type': 'folder_file',
                                                'content_id': content_id,
                                                'gofile_fid': fid,
                                                'dlink': dl,
                                                'updated_at': now
                                            }
                            dlink = new_dlink
            except Exception as e:
                print(f"Error auto-refreshing Gofile link: {e}")
        if not dlink:
            dlink = entry['dlink']
    elif isinstance(entry, dict) and entry.get('type') == 'direct_link':
        dlink = entry['url']
    else:
        dlink = entry if isinstance(entry, str) else None
        
    if not dlink: return "Gofile link expired or not found.", 404
    
    t, is_guest = get_active_gofile_token()
    headers = {'User-Agent': SPOOF_AGENT, 'Accept': '*/*', 'Connection': 'keep-alive'}
    rh = request.headers.get('Range')
    if rh: headers['Range'] = rh
    
    cookies = {}
    if t:
        cookies['accountToken'] = t
        headers['Cookie'] = f"accountToken={t}"
        
    r = requests.get(dlink, headers=headers, cookies=cookies, stream=True, allow_redirects=True, timeout=(15, 86400))
    register_download_conn(file_id, r)
    
    def gen_gofile():
        try:
            for ck in r.iter_content(STREAM_CHUNK_SIZE):
                yield ck
        finally:
            unregister_download_conn(file_id, r)
            r.close()
            
    resp = Response(gen_gofile(), status=r.status_code)
    for k, v in r.headers.items():
        if k.lower() in ['content-length', 'content-range', 'accept-ranges']: resp.headers[k] = v
    resp.headers['Content-Type'] = 'application/octet-stream'
    resp.headers['X-Accel-Buffering'] = 'no'
    resp.headers['Content-Disposition'] = f'attachment; filename="{urllib.parse.quote(fname)}"'
    return resp

