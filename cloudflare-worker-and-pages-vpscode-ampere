                if n_all and net_p:
                    cs = sum(nic.bytes_sent for name, nic in n_all.items() if name != 'lo')
                    cr = sum(nic.bytes_recv for name, nic in n_all.items() if name != 'lo')
                    t = time.time(); d = t - net_pt or 1; s, r = (cs - net_p["sent"]) / d, (cr - net_p["recv"]) / d
