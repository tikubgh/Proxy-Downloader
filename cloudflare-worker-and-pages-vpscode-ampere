        stream_id = hashlib.md5(f"{target_url}_{session_cb}_{audio_idx}".encode()).hexdigest()
        stream_dir = os.path.join(HLS_DIR, stream_id)
        
        # Link HLS stream back to the database for Instant Clean Abort 
        if fid != 'none' and fid != 'null':
            with db_lock:
                if fid in db:
                    if 'hls_streams' not in db[fid]:
                        db[fid]['hls_streams'] = set()
                    db[fid]['hls_streams'].add(stream_id)
        
        input_target = resolve_target(target_url)
        if not input_target: return jsonify({'error': 'Failed to resolve streaming target.'}), 500

        http_opts = []
        if input_target.startswith('http'):
            http_opts.extend(['-user_agent', SPOOF_AGENT, '-reconnect', '1', '-reconnect_streamed', '1', '-reconnect_delay_max', '5'])

        cmd_probe_v = ['ffprobe', '-v', 'error']
        cmd_probe_v.extend(http_opts)
        cmd_probe_v.extend(['-select_streams', 'v:0', '-show_entries', 'stream=codec_name', '-of', 'default=noprint_wrappers=1:nokey=1', input_target])
        
        try: v_codec = subprocess.check_output(cmd_probe_v, timeout=10).decode().strip().lower()
        except: v_codec = "unknown"

        vcodec_args = ['-c:v', 'copy']
        if v_codec in ['hevc', 'h265']: vcodec_args = ['-c:v', 'copy', '-tag:v', 'hvc1']

        cmd_probe_a = ['ffprobe', '-v', 'error']
        cmd_probe_a.extend(http_opts)
        cmd_probe_a.extend(['-select_streams', f'a:{audio_idx}', '-show_entries', 'stream=codec_name', '-of', 'default=noprint_wrappers=1:nokey=1', input_target])
        
        try: a_codec = subprocess.check_output(cmd_probe_a, timeout=10).decode().strip().lower()
        except: a_codec = "unknown"

        if a_codec in ['aac', 'mp3', 'opus', 'flac', 'vorbis', 'ac3']:
            acodec_args = ['-c:a', 'copy']
        else:
            acodec_args = ['-c:a', 'aac', '-ac', '2', '-b:a', '192k', '-ar', '48000']

        if stream_id not in hls_procs or hls_procs[stream_id].poll() is not None:
            os.makedirs(stream_dir, exist_ok=True)
            for f in os.listdir(stream_dir): 
                try: os.remove(os.path.join(stream_dir, f))
                except: pass
                
            log_path = os.path.join(stream_dir, 'ffmpeg.log')
            log_fd = open(log_path, 'w')
            
            cmd = ['ffmpeg', '-hide_banner', '-loglevel', 'warning']
            cmd.extend(http_opts)
            cmd.extend([
                '-fflags', '+genpts+discardcorrupt',
                '-threads', '0', 
                '-i', input_target,
                '-map', '0:v:0?', '-map', f'0:a:{audio_idx}?', 
                *vcodec_args,
                *acodec_args,
                '-sn',
                '-start_at_zero', '-avoid_negative_ts', 'make_zero',
                '-max_muxing_queue_size', '9999',
                '-f', 'hls',
                '-hls_time', '4', 
                '-hls_segment_type', 'mpegts',
                '-hls_flags', 'independent_segments+delete_segments',
                '-hls_list_size', '0', 
                os.path.join(stream_dir, 'index.m3u8')
            ])
            
            try: hls_procs[stream_id] = subprocess.Popen(cmd, stderr=log_fd)
            except Exception as e: return jsonify({'error': f'Backend Execution Failure: {str(e)}'}), 500
            
            for _ in range(150):
                if os.path.exists(os.path.join(stream_dir, 'index.m3u8')):
                    break
                ret = hls_procs[stream_id].poll()
                if ret is not None:
                    log_fd.close()
                    err_msg = "Unknown Error"
                    if os.path.exists(log_path):
                        with open(log_path, 'r') as f:
                            err_msg = f.read()[-400:].replace('\n', ' | ')
                    return jsonify({'error': f'FFmpeg Core Crash (Exit {ret}). Reason: {err_msg}'}), 500
                time.sleep(0.1)
            
        return jsonify({'playlist_url': f'/hls/{stream_id}/index.m3u8', 'stream_id': stream_id, 'transcoded': False})
    except Exception as e:
        return jsonify({'error': f'Unhandled Backend Exception: {str(e)}'}), 500

@app.route('/api/stop_hls')
def stop_hls():
    try:
        stream_id = request.args.get('stream_id')
        if stream_id and stream_id in hls_procs:
            try:
                hls_procs[stream_id].terminate()
                hls_procs[stream_id].wait(timeout=2)
            except:
                try: hls_procs[stream_id].kill()
                except: pass
            del hls_procs[stream_id]
            stream_dir = os.path.join(HLS_DIR, stream_id)
            shutil.rmtree(stream_dir, ignore_errors=True)
        return jsonify({'success': True})
    except Exception as e:
        return jsonify({'error': str(e)}), 500

