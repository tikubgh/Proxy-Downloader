            else: rf = HttpRangeFile(base64.urlsafe_b64decode(bu.encode()).decode())
            with zipfile.ZipFile(rf) as zf:
                with zf.open(tf['name']) as z_item:
                    try: z_item.seek(sb)
                    except:
                        to_skip = sb
                        while to_skip > 0: sk = min(to_skip, 4194304); z_item.read(sk); to_skip -= sk
                    c = sb
                    while c <= eb:
                        d = z_item.read(min(STREAM_CHUNK_SIZE, eb - c + 1))
                        if not d: break
                        yield d; c += len(d)
        except Exception as e: print("Stream error:", e)
    return Response(gen(), status=206 if rh else 200, headers=hdrs)

def update_file_metadata(fid, r):
    cd, nn = r.headers.get('content-disposition', ''), None
    if cd:
        m = re.search(r"filename\s*\*=\s*UTF-8''([^;]+)", cd, re.IGNORECASE) or re.search(r'filename\s*=\s*"([^"]+)"', cd, re.IGNORECASE) or re.search(r'filename\s*=\s*([^;]+)', cd, re.IGNORECASE)
        if m: nn = urllib.parse.unquote(m.group(1)).strip(' \'"')
    if not nn:
        bn = urllib.parse.unquote(os.path.basename(urllib.parse.urlparse(r.url).path))
        if bn and '.' in bn: nn = bn
    if nn:
        sn = re.sub(r'[\\/*?:"<>|]', "", nn).strip()
        if sn:
            with db_lock:
                if fid in db:
                    op = db[fid]['path']; np = os.path.join(DL_DIR, f"{fid}_{sn}"); db[fid]['name'] = sn; db[fid]['path'] = np
                    if os.path.exists(op) and op != np: os.rename(op, np)

