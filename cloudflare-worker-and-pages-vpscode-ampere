@app.route('/api/p2p_poll/<fid>')
def p2p_poll(fid):
    with db_lock:
        if fid not in db or db[fid]['status'] == 'Stopped': return "Stopped", 400
        ftype = db[fid]['type']
        
    ret = []
    now = time.time()
    
    if ftype == 'p2p':
        if fid not in p2p_streams: return "Not Found", 404
        stream = p2p_streams[fid]
        with stream.lock:
            stale = [i for i, t in stream.active.items() if now - t > 10]
            for i in stale:
                del stream.active[i]
                if i not in stream.chunks: stream.needed.add(i)

            needed_list = list(stream.needed)
            for idx in needed_list:
                if len(ret) >= 16: break
                stream.needed.remove(idx)
                stream.active[idx] = now
                ret.append(idx)
                
    elif ftype == 'disk_relay':
        if fid not in disk_streams: return "Not Found", 404
        stream = disk_streams[fid]
        with stream.lock:
            stale = [i for i, t in stream.active.items() if now - t > 10]
            for i in stale:
                del stream.active[i]
                if i not in stream.written_chunks: stream.prioritized.add(i)

            pri_list = sorted(list(stream.prioritized))
            for idx in pri_list:
                if len(ret) >= 16: break
                stream.prioritized.remove(idx)
                stream.active[idx] = now
                ret.append(idx)
            
            if len(ret) < 16:
                bg_list = sorted(list(stream.background))
                for idx in bg_list:
                    if len(ret) >= 16: break
                    stream.background.remove(idx)
                    stream.active[idx] = now
                    ret.append(idx)
    return jsonify(ret)

@app.route('/api/p2p_up/<fid>/<int:idx>', methods=['POST'])
def p2p_up(fid, idx):
    with db_lock:
        if fid not in db or db[fid]['status'] == 'Stopped': return "Stopped", 400
        ftype = db[fid]['type']
        fp = db[fid]['path']
        
    data = request.data
    
    if ftype == 'p2p':
        if fid not in p2p_streams: return "Not Found", 404
        stream = p2p_streams[fid]
        with stream.lock:
            stream.chunks[idx] = data
            if idx in stream.active: del stream.active[idx]
            if idx in stream.needed: stream.needed.remove(idx)
            
            if len(stream.chunks) > 250:
                oldest = next(iter(stream.chunks))
                del stream.chunks[oldest]
            stream.cond.notify_all()
        with db_lock: db[fid]['down'] += len(data)
        
    elif ftype == 'disk_relay':
        if fid not in disk_streams: return "Not Found", 404
        stream = disk_streams[fid]
        start_byte = idx * P2P_CHUNK_SIZE
        
        expected_len = min(P2P_CHUNK_SIZE, stream.total_size - start_byte)
        if len(data) != expected_len and stream.total_size > 0: return "Incomplete", 400
        
        with open(fp, 'r+b') as f:
            f.seek(start_byte)
            f.write(data)
            f.flush() 
            
        with stream.lock:
            if idx in stream.active: del stream.active[idx]
            stream.written_chunks.add(idx)
            stream.cond.notify_all()
            
        with db_lock: db[fid]['down'] += len(data)
        
        with stream.lock:
            if not stream.background and not stream.prioritized and not stream.active:
                with db_lock:
                    if db[fid]['status'] != 'Stopped': db[fid]['status'] = 'Completed'
    return "OK"

@app.route('/relay_dl/<fid>/<path:fname>', methods=['GET', 'HEAD'])
def relay_dl(fid,fname):
 with db_lock:
  if fid not in db or db[fid]['type'] not in ['p2p', 'disk_relay']: return "404",404
  f=db[fid]; ftype=f['type']; ts=f.get('total', 0)

 last_mod = time.strftime('%a, %d %b %Y %H:%M:%S GMT', time.gmtime(f.get('start', time.time())))
 etag = f'"{fid}-{ts}"'
 mt = mimetypes.guess_type(f['name'])[0] or 'application/octet-stream'
 disp = 'inline' if mt.startswith(('video/', 'audio/')) else 'attachment'

 rh = request.headers.get('Range')
 sb = 0
 eb = ts - 1 if ts > 0 else 0
 is_range = False

 if rh:
  m = re.search(r'bytes=(\d+)-(\d*)', rh)
  if m:
   sb = int(m.group(1))
   if m.group(2): eb = int(m.group(2))
   is_range = True

 hdrs = {
  'Accept-Ranges': 'bytes',
  'ETag': etag,
  'Last-Modified': last_mod,
  'Cache-Control': 'no-cache, no-store, must-revalidate',
  'X-Accel-Buffering': 'no',
  'Access-Control-Allow-Origin': '*'
 }

 if request.method == 'HEAD':
  hdrs['Content-Type'] = mt
  if ts > 0: hdrs['Content-Length'] = str(ts)
  return Response(status=200, headers=hdrs)

 if ftype == 'p2p':
  stream = p2p_streams[fid]
  stream.connected = True
  with db_lock: db[fid]['status']='Transferring (P2P)'
  
  def gen_p2p():
   curr = sb
   max_chunk = ((ts - 1) // P2P_CHUNK_SIZE) if ts > 0 else float('inf')
   
   while curr <= eb:
    idx = curr // P2P_CHUNK_SIZE
    offset = curr % P2P_CHUNK_SIZE
    
    with stream.lock:
     for i in range(idx, min(idx + 16, max_chunk + 1)):
      if i not in stream.chunks and i not in stream.active:
       stream.needed.add(i)
       
     while idx not in stream.chunks:
      with db_lock:
       if fid not in db or db[fid]['status'] == 'Stopped': return
      if idx not in stream.needed and idx not in stream.active:
       stream.needed.add(idx)
      stream.cond.wait(timeout=1.0)
      
     data = stream.chunks[idx]
     
    rem_in_chunk = len(data) - offset
    rem_in_req = eb - curr + 1
    take = min(rem_in_chunk, rem_in_req)
    
    yield data[offset : offset + take]
    curr += take

  hdrs['Content-Disposition'] = f'{disp}; filename="{f["name"]}"'
  hdrs['Content-Type'] = mt
  if ts > 0:
   l = eb - sb + 1
   hdrs['Content-Length'] = str(l)
   if is_range:
    hdrs['Content-Range'] = f'bytes {sb}-{eb}/{ts}'
    return Response(gen_p2p(), status=206, headers=hdrs)
  return Response(gen_p2p(), status=200, headers=hdrs)

 elif ftype == 'disk_relay':
  stream = disk_streams.get(fid)
  if not stream: return "Not Found", 404
  fp = f['path']
  stream.connected = True
  with db_lock: db[fid]['status'] = 'Transferring (Disk Buffered)'
  
  def gen_disk():
   curr = sb
   max_chunk = ((ts - 1) // P2P_CHUNK_SIZE) if ts > 0 else float('inf')
   
   with open(fp, 'rb') as lf:
    while curr <= eb:
     idx = curr // P2P_CHUNK_SIZE
     
     with stream.lock:
      for i in range(idx, min(idx + 16, max_chunk + 1)):
       if i not in stream.written_chunks and i not in stream.active:
        stream.prioritized.add(i)
        if i in stream.background: stream.background.remove(i)
        
      while idx not in stream.written_chunks:
       with db_lock:
        if fid not in db or db[fid]['status'] == 'Stopped': return
       if idx not in stream.active and idx not in stream.prioritized: 
        stream.prioritized.add(idx)
       stream.cond.wait(timeout=1.0)
       
     rem_in_chunk = P2P_CHUNK_SIZE - (curr % P2P_CHUNK_SIZE)
     rem_in_req = eb - curr + 1
     take = min(rem_in_chunk, rem_in_req)
     
     lf.seek(curr)
     data = lf.read(take)
     if data:
      yield data
      curr += len(data)
     else: time.sleep(0.1)

  hdrs['Content-Disposition'] = f'{disp}; filename="{f["name"]}"'
  hdrs['Content-Type'] = mt
  if ts > 0:
   l = eb - sb + 1
   hdrs['Content-Length'] = str(l)
   if is_range:
    hdrs['Content-Range'] = f'bytes {sb}-{eb}/{ts}'
    return Response(gen_disk(), status=206, headers=hdrs)
  return Response(gen_disk(), status=200, headers=hdrs)

@app.route('/api/drive/status')
def drive_status():
    if not os.path.exists(DRIVE_CREDS_FILE): return jsonify({'connected': False})
    try:
        access_token, err = get_drive_auth()
        if err: return jsonify({'connected': False})
        
        r = requests.get('https://www.googleapis.com/drive/v3/about?fields=storageQuota', headers={'Authorization': f'Bearer {access_token}'}, timeout=10)
        if r.status_code == 200:
            sq = r.json().get('storageQuota', {})
            limit = int(sq.get('limit', 0))
            usage = int(sq.get('usage', 0))
            if limit > 0:
                avail = limit - usage
                info = f"{avail / (1024**3):.1f} GB Available"
            else:
                info = "Unlimited / Shared Drive"
            return jsonify({'connected': True, 'info': info})
    except: pass
    return jsonify({'connected': False})

@app.route('/api/drive/connect', methods=['POST'])
def drive_connect():
    data = request.json
    cid, csec, rt = data.get('client_id'), data.get('client_secret'), data.get('refresh_token')
    try:
        r = requests.post('https://oauth2.googleapis.com/token', data={'client_id': cid, 'client_secret': csec, 'refresh_token': rt, 'grant_type': 'refresh_token'}, timeout=10)
        if r.status_code == 200:
            now = time.time()
            data['access_token'] = r.json()['access_token']
            data['expires_at'] = now + 3500
            with open(DRIVE_CREDS_FILE, 'w') as f: json.dump(data, f)
            return jsonify({'success': True})
        return jsonify({'success': False, 'error': 'Google rejected keys. Ensure Client Secret & Refresh Token are valid.'})
    except Exception as e:
        return jsonify({'success': False, 'error': str(e)})

