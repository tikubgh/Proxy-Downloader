def get_drive_auth():
    try:
        with drive_creds_lock:
            if not os.path.exists(DRIVE_CREDS_FILE): return None, "Vault Empty"
            with open(DRIVE_CREDS_FILE, 'r') as f:
                try:
                    creds = json.load(f)
                except:
                    return None, "Invalid vault JSON"
            now = time.time()
            if 'access_token' in creds and 'expires_at' in creds and now < creds['expires_at']:
                return creds['access_token'], None
            if 'client_id' not in creds: return None, "Missing credentials"
            r = drive_api_session.post('https://oauth2.googleapis.com/token', data={'client_id': creds['client_id'], 'client_secret': creds['client_secret'], 'refresh_token': creds['refresh_token'], 'grant_type': 'refresh_token'}, timeout=15)
            if r.status_code != 200: return None, "Google rejected Refresh Token."
            new_token = r.json()['access_token']
            creds['access_token'] = new_token
            creds['expires_at'] = now + 3500
            with open(DRIVE_CREDS_FILE, 'w') as f:
                json.dump(creds, f)
            return new_token, None
    except Exception as e:
        return None, str(e)

def resolve_target(target_url, fid=None):
    if target_url:
        parsed = urllib.parse.urlparse(target_url)
        local_url = f"http://127.0.0.1:8080{parsed.path}"
        if parsed.query: local_url += f"?{parsed.query}"
        input_target = local_url
        with db_lock:
            for db_fid, fobj in db.items():
                if fobj.get('name') and urllib.parse.quote(fobj['name']) in target_url:
                    if fobj.get('status') == 'Completed' and fobj.get('path') and os.path.exists(fobj['path']):
                        input_target = fobj['path']
                        break
                    elif fobj.get('url') and not fobj.get('type', '').startswith('drive'):
                        input_target = fobj['url']
                        break
        return input_target
    elif fid:
        with db_lock:
            if fid not in db: return None
            fobj = db[fid]
        if fobj.get('status') == 'Completed' and fobj.get('path') and os.path.exists(fobj['path']): return fobj['path']
        if fobj.get('url') and not fobj.get('type', '').startswith('drive'): return fobj['url']
        return fobj.get('url')
    return None

