def multi_worker(fid):
    with db_lock:
        if fid not in db: return
        u = db[fid]['url']
        db[fid]['active_threads'] = 0

    session = requests.Session()
    engine3_retries = Retry(total=8, backoff_factor=1, status_forcelist=[429, 500, 502, 503, 504], allowed_methods=["GET", "HEAD", "OPTIONS"])
    adapter = requests.adapters.HTTPAdapter(pool_connections=32, pool_maxsize=32, max_retries=engine3_retries)
    session.mount('http://', adapter)
    session.mount('https://', adapter)

    try:
        r = session.get(u, headers=HEADERS, stream=True, timeout=15, allow_redirects=True)
        r.raise_for_status()
        update_file_metadata(fid, r)
        tot = int(r.headers.get('content-length', 0))
        supports_range = r.headers.get('accept-ranges') == 'bytes' or r.headers.get('Content-Range') or r.headers.get('content-length')
        r.close()

        with db_lock: 
            if fid not in db: return # Aborted
            db[fid]['total'] = tot
            db[fid]['written'] = set()
            db[fid]['priority'] = {0} 
            p = db[fid]['path']

        if tot == 0 or not supports_range:
            dl_worker(fid)
            return

        with open(p, 'wb') as f: f.truncate(tot)
        fd = os.open(p, os.O_WRONLY) 

        chunk_size = max(2097152, min(8388608, tot // 32))
        with db_lock: db[fid]['chunk_size'] = chunk_size

        total_chunks = (tot + chunk_size - 1) // chunk_size
        pending_chunks = set(range(total_chunks))
        active_chunks = set()
        lock = threading.Lock()
        error_flag = []

        def get_next_chunk():
            with lock:
                with db_lock:
                    if fid not in db: return None
                    pri = list(db[fid].get('priority', set()))
                for c in pri:
                    if c in pending_chunks and c not in active_chunks:
                        active_chunks.add(c)
                        return c
                for c in sorted(list(pending_chunks)):
                    if c not in active_chunks:
                        active_chunks.add(c)
                        return c
                return None

        def worker():
            while True:
                if error_flag: break
                
                with db_lock:
                    if fid not in db or db[fid].get('status') == 'Stopped': 
                        error_flag.append(True)
                        break
                
                c_idx = get_next_chunk()
                if c_idx is None: break
                
                start = c_idx * chunk_size
                end = min(start + chunk_size - 1, tot - 1)
                h = HEADERS.copy()
                h['Range'] = f'bytes={start}-{end}'
                
                success = False
                for attempt in range(8):
                    with db_lock: 
                        if fid in db: db[fid]['active_threads'] += 1
                    try:
                        res = session.get(u, headers=h, timeout=(5, 25), stream=True)
                        res.raise_for_status()
                        
                        current_offset = start
                        for chunk_data in res.iter_content(chunk_size=262144):
                            # Hard Interrupt Check
                            with db_lock:
                                if fid not in db or db[fid].get('status') == 'Stopped':
                                    error_flag.append(True)
                                    raise Exception("Aborted")
                            if chunk_data:
                                os.pwrite(fd, chunk_data, current_offset)
                                current_offset += len(chunk_data)
                                with db_lock: 
                                    if fid in db: db[fid]['down'] += len(chunk_data)

                        with db_lock: 
                            if fid in db:
                                db[fid]['written'].add(start)
                                if 'priority' in db[fid] and c_idx in db[fid]['priority']:
                                    db[fid]['priority'].remove(c_idx)
                        with lock:
                            pending_chunks.remove(c_idx)
                            active_chunks.remove(c_idx)
                        success = True
                        with db_lock: 
                            if fid in db: db[fid]['active_threads'] -= 1
                        break
                    except Exception:
                        with db_lock: 
                            if fid in db: db[fid]['active_threads'] -= 1
                        time.sleep(1.5 ** attempt)
                if not success:
                    error_flag.append(True)
                    break

        max_threads = 32
        threads = []
        for _ in range(max_threads):
            t = threading.Thread(target=worker)
            t.start()
            threads.append(t)
            
        while pending_chunks and not error_flag:
            with db_lock:
                if fid not in db or db[fid].get('status') == 'Stopped':
                    error_flag.append(True)
            time.sleep(1)
            
        error_flag.append(True)
        for t in threads: t.join()
        
        os.close(fd) 
        
        with db_lock:
            is_aborted = fid not in db or db[fid].get('status') == 'Stopped'
            
        if is_aborted:
            try: os.remove(p)
            except: pass
        else:
            with db_lock:
                if fid in db:
                    db[fid]['active_threads'] = 0
                    db[fid]['status'] = 'Completed'

    except Exception as e:
        with db_lock: 
            if fid in db: db[fid]['status'] = f'Error: {str(e)[:40]}'


def engine5_worker(fid):
