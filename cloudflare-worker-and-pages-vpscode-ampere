        start = chunk_idx * self.chunk_size
        end = min(start + self.chunk_size - 1, self.size - 1) if self.size > 0 else start + self.chunk_size - 1
        if self.size > 0 and start >= self.size:
            return b''
        h = self.headers.copy()
        h['Range'] = f'bytes={start}-{end}'
        if self.fid:
            with db_lock:
                if self.fid not in db or db[self.fid].get('status') == 'Stopped':
                    return b''
        data = b''
        try:
            r = stream_session.get(self.url, headers=h, timeout=15, stream=True)
            if self.fid:
                register_download_conn(self.fid, r)
            try:
                if r.status_code in [200, 206]:
                    blocks = []
                    for chunk in r.iter_content(131072):
                        if not self.active:
                            break
                        blocks.append(chunk)
                    data = b''.join(blocks) if self.active else b''
            finally:
                if self.fid:
                    unregister_download_conn(self.fid, r)
                r.close()
        except Exception as e:
            print("Chunk fetch error:", e)
            data = b''
        if self.active and data:
            with shared_drive_lock:
                shared_drive_cache[ck] = data
                while len(shared_drive_cache) > 128:
                    shared_drive_cache.popitem(last=False)
        return data

    def _get_chunk(self, chunk_idx):
        if not self.active:
            return b''
        for next_i in range(chunk_idx + 1, chunk_idx + 9):
            if not self.active:
                break
            nck = f"http_{self.file_id}_{next_i}"
            with shared_drive_lock:
                already_cached = nck in shared_drive_cache
            if not already_cached and (self.size == 0 or next_i * self.chunk_size < self.size):
                self.executor.submit(self._fetch_single_chunk, next_i)

        return self._fetch_single_chunk(chunk_idx)

    def read(self, size=-1):
        if not self.active or (self.size > 0 and self.pos >= self.size):
            return b''
        if size < 0 or (self.size > 0 and self.pos + size > self.size):
            size = (self.size - self.pos) if self.size > 0 else 2097152
        res = bytearray()
        while size > 0 and self.active:
            if self.size > 0 and self.pos >= self.size:
                break
            c_idx = self.pos // self.chunk_size
            c_off = self.pos % self.chunk_size
            c_data = self._get_chunk(c_idx)
            if not c_data or not self.active:
                break
            avail = len(c_data) - c_off
            if avail <= 0:
                break
            t = min(size, avail)
            res.extend(c_data[c_off : c_off + t])
            self.pos += t
            size -= t
        return bytes(res)

    def seek(self, offset, whence=0):
        if whence == 0: self.pos = offset
        elif whence == 1: self.pos += offset
        elif whence == 2: self.pos = (self.size + offset) if self.size > 0 else offset
        if self.size > 0:
            self.pos = max(0, min(self.pos, self.size))
        else:
            self.pos = max(0, self.pos)
        return self.pos

    def tell(self): return self.pos
    def seekable(self): return True
    def readable(self): return True
    def writable(self): return False
    def close(self):
        self.active = False
        if hasattr(self, 'executor'):
            try: self.executor.shutdown(wait=False)
