def update_telemetry():
    global sys_data, net_p, net_pt
    try: n_all = psutil.net_io_counters(pernic=True); net_p = {"sent": sum(nic.bytes_sent for name, nic in n_all.items() if name != 'lo'), "recv": sum(nic.bytes_recv for name, nic in n_all.items() if name != 'lo')}
    except: pass
    while True:
        time.sleep(1)
        try:
            cpu = f"{psutil.cpu_percent()}%"; vm = psutil.virtual_memory(); ram = f"{fmt_bytes(vm.used)} / {fmt_bytes(vm.available)} / {fmt_bytes(vm.total)}"
            sm = psutil.swap_memory(); swap = f"{fmt_bytes(sm.used)} / {fmt_bytes(sm.free)} / {fmt_bytes(sm.total)}"; du = shutil.disk_usage("/")
            disk = f"{fmt_bytes(du.used)} / {fmt_bytes(du.free)} / {fmt_bytes(du.total)}"; ns = "N/A"
            try:
                n_all = psutil.net_io_counters(pernic=True)
                if n_all and net_p:
                    cs = sum(nic.bytes_sent for name, nic in n_all.items() if name != 'lo'); cr = sum(nic.bytes_recv for name, nic in n_all.items() if name != 'lo')
                    t = time.time(); d = t - net_pt or 1; s, r = (cs - net_p["sent"]) / d, (cr - net_p["recv"]) / d
                    net_p, net_pt = {"sent": cs, "recv": cr}, t; spd = lambda b: f"{b/1024:.1f} KB/s" if b < 1024**2 else f"{b/(1024**2):.1f} MB/s"
                    ns = f"Live: ↑ {spd(s)} Up ↓ {spd(r)} Down  |  Total: {fmt_bytes(cs)} Up / {fmt_bytes(cr)} Down"
            except: pass
            sys_data = {"cpu": cpu, "ram": ram, "swap": swap, "disk": disk, "net": ns}
        except: pass
