                    with db_lock:
                        if tot > 0 and db[fid]['down'] < tot: rets += 1; time.sleep(2); continue
                    break
                except Exception as e:
                    rets += 1; time.sleep(2)
                    if rets >= 20: raise e
            with db_lock: db[fid]['status'] = 'Completed' if fid in db and db[fid]['status'] != 'Stopped' else 'Stopped'
            return

        if mode == 'multi':
            open(p, 'wb').truncate(tot); fd = os.open(p, os.O_WRONLY)
            csz = max(262144, min(2097152, tot // 512 if tot > 0 else 2097152))
            with db_lock: db[fid]['chunk_size'] = csz
            tc = (tot + csz - 1) // csz; pc, ac, lk, ef = set(range(tc)), set(), threading.Lock(), []
            sc, ma, ll, ss, aw, let = 256, 4, False, True, 0, time.time()
            def get_nc():
                with lk:
