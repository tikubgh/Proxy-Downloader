@app.route('/stream/<fid>/<path:fname>', methods=['GET', 'HEAD'])
def unified_stream(fid, fname):
    with db_lock:
        if fid not in db: return "404", 404
        fobj = db[fid]
    
    ftype = fobj.get('type')
    mt = mimetypes.guess_type(fname)[0] or 'application/octet-stream'
    rh = request.headers.get('Range')

    def get_range_bounds(ts):
        sb, eb = 0, ts - 1 if ts else 0
        if rh and ts:
            m = re.search(r'bytes=(\d+)-(\d*)', rh)
            if m: sb, eb = int(m.group(1)), int(m.group(2)) if m.group(2) else eb
        return sb, eb

    if 'drive' in ftype:
        file_id = fobj.get('file_id')
        if not file_id: file_id = extract_drive_id(fobj.get('url', ''))
        if not file_id: return "No Drive ID", 404
        token, err = get_drive_auth()
        if err: return "Auth Error", 403
        
        headers = {'Authorization': f'Bearer {token}', 'User-Agent': SPOOF_AGENT}
        if rh: headers['Range'] = rh
        drive_url = f'<https://www.googleapis.com/drive/v3/files/{file_id}?alt=media&supportsAllDrives=true>'
        
        r = drive_api_session.get(drive_url, headers=headers, stream=True, allow_redirects=True, timeout=15)
        resp = Response(r.iter_content(STREAM_CHUNK_SIZE), status=r.status_code)
        for k, v in r.headers.items():
            if k.lower() in ['content-length', 'content-type', 'content-range', 'accept-ranges']: resp.headers[k] = v
        resp.headers['Content-Disposition'] = f'inline; filename="{urllib.parse.quote(fname)}"'
        return resp
        
    elif ftype in ['ram', 'swarm']:
        headers = HEADERS.copy()
        if rh: headers['Range'] = rh
        r = requests.get(fobj['url'], headers=headers, stream=True, allow_redirects=True, timeout=15)
        resp = Response(r.iter_content(STREAM_CHUNK_SIZE), status=r.status_code)
        for k, v in r.headers.items():
            if k.lower() in ['content-length', 'content-type', 'content-range', 'accept-ranges']: resp.headers[k] = v
        resp.headers['Content-Disposition'] = f'inline; filename="{urllib.parse.quote(fname)}"'
        return resp
        
    else:
        fp = fobj.get('path')
        if not fp or not os.path.exists(fp): return "404", 404
        ts = os.path.getsize(fp)
        sb, eb = get_range_bounds(ts)
        hdrs = {'Content-Type': mt, 'Accept-Ranges': 'bytes', 'Content-Disposition': f'inline; filename="{urllib.parse.quote(fname)}"'}
        if ts: hdrs.update({'Content-Length': str(eb - sb + 1), 'Content-Range': f'bytes {sb}-{eb}/{ts}'})
        if request.method == 'HEAD': return Response(status=206 if rh else 200, headers=hdrs)
        
        def gen_local():
            with open(fp, 'rb') as lf:
                lf.seek(sb)
                c = sb
                while c <= eb:
                    d = lf.read(min(STREAM_CHUNK_SIZE, eb - c + 1))
                    if not d: break
                    yield d
                    c += len(d)
        return Response(gen_local(), status=206 if rh else 200, headers=hdrs)

@app.route('/<string:a_type>_archive_dl/<string:bu>/<string:b64_name>/<path:fname>', methods=['GET', 'HEAD'])
def archive_stream(a_type, bu, b64_name, fname):
    global global_mounted_data
    if not global_mounted_data: return "404", 404
    tf = next((x for x in global_mounted_data['files'] if x['b64'] == b64_name), None)
    if not tf: return "404", 404
    
    rh = request.headers.get('Range')
    ts = tf['size']
    sb, eb = 0, ts - 1 if ts else 0
    if rh and ts:
        m = re.search(r'bytes=(\d+)-(\d*)', rh)
        if m: sb, eb = int(m.group(1)), int(m.group(2)) if m.group(2) else eb
        
    mt = mimetypes.guess_type(fname)[0] or 'application/octet-stream'
    hdrs = {'Content-Type': mt, 'Accept-Ranges': 'bytes', 'Content-Disposition': f'inline; filename="{urllib.parse.quote(fname)}"'}
    if ts: hdrs.update({'Content-Length': str(eb - sb + 1), 'Content-Range': f'bytes {sb}-{eb}/{ts}'})
    if request.method == 'HEAD': return Response(status=206 if rh else 200, headers=hdrs)
    
    def gen():
        try:
            if a_type == 'drive':
                t, _ = get_drive_auth()
                rf = DriveRangeFile(bu, t, 100000000)
            elif a_type == 'swarm': rf = SwarmRangeFile(base64.urlsafe_b64decode(bu.encode()).decode())
            else: rf = HttpRangeFile(base64.urlsafe_b64decode(bu.encode()).decode())
            
            with zipfile.ZipFile(rf) as zf:
                with zf.open(tf['name']) as z_item:
                    try: z_item.seek(sb)
                    except:
                        to_skip = sb
                        while to_skip > 0:
                            sk = min(to_skip, 4194304)
                            z_item.read(sk)
                            to_skip -= sk
                    c = sb
                    while c <= eb:
                        d = z_item.read(min(STREAM_CHUNK_SIZE, eb - c + 1))
                        if not d: break
                        yield d
                        c += len(d)
        except Exception as e: print("Stream error:", e)
    return Response(gen(), status=206 if rh else 200, headers=hdrs)

