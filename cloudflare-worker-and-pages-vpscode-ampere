def drive_worker(fid):
    with db_lock:
        if fid not in db: return
        u = db[fid]['url']
        
    try:
        token, err = get_drive_auth()
        if err: raise Exception(err)
        
        r_head = requests.get(u, stream=True, headers=HEADERS, timeout=15, allow_redirects=True)
        update_file_metadata(fid, r_head)
        tot = int(r_head.headers.get('content-length', 0))
        
        with db_lock: 
            db[fid]['total'] = tot
            db[fid]['status'] = 'Piping to Drive (RAM)...'
            name = db[fid]['name']
        
        if tot == 0: raise Exception("Content-Length required for Drive stream")
        
        mt = mimetypes.guess_type(name)[0] or 'application/octet-stream'
        meta = {'name': name}
        
        init_res = drive_api_session.post(
            'https://www.googleapis.com/upload/drive/v3/files?uploadType=resumable',
            headers={'Authorization': f'Bearer {token}', 'Content-Type': 'application/json', 'X-Upload-Content-Type': mt, 'X-Upload-Content-Length': str(tot)},
            json=meta, timeout=30
        )
        init_res.raise_for_status()
        upload_url = init_res.headers['Location']
        
        chunk_size = 67108864 # 64MB Buffer strictly enforced for gigabit Drive API chunking
        start_byte = 0
        file_id = None
        buf = bytearray()

        def upload_chunk(data_bytes):
            nonlocal start_byte, file_id
            chunk_len = len(data_bytes)
            end_byte = start_byte + chunk_len - 1
            headers = {'Content-Range': f'bytes {start_byte}-{end_byte}/{tot}', 'Content-Length': str(chunk_len)}
            
            for _ in range(5):
                try:
                    res = drive_api_session.put(upload_url, data=data_bytes, headers=headers, timeout=120)
                    if res.status_code in [308, 200, 201]:
                        if res.status_code in [200, 201]: file_id = res.json().get('id')
                        start_byte += chunk_len
                        with db_lock: db[fid]['down'] = start_byte
                        return True
                except: time.sleep(2)
            return False

        for chunk in r_head.iter_content(chunk_size=4194304):
            with db_lock:
                if db[fid]['status'] == 'Stopped': 
                    r_head.close()
                    raise Exception("Stopped by user")
            if chunk:
                buf.extend(chunk)
                while len(buf) >= chunk_size:
                    c_data = bytes(buf[:chunk_size])
                    del buf[:chunk_size]
                    if not upload_chunk(c_data): raise Exception("Drive chunk upload rejected after 5 retries.")
                    
        if buf:
            if not upload_chunk(bytes(buf)): raise Exception("Final Drive chunk upload rejected.")
            
        with db_lock:
            if db[fid]['status'] != 'Stopped': 
                db[fid]['status'] = 'Completed'
                db[fid]['type'] = 'drive_direct'
                db[fid]['file_id'] = file_id
            
    except Exception as e:
        with db_lock: db[fid]['status'] = f'Error: {str(e)[:40]}'

def drive_swarm_worker(fid):
    with db_lock:
        if fid not in db: return
        u = db[fid]['url']
        db[fid]['status'] = 'Swarm Piping to Drive (RAM)...'
        
    try:
        token, err = get_drive_auth()
        if err: raise Exception(err)
        
        r = requests.get(u, headers=HEADERS, stream=True, timeout=15, allow_redirects=True)
        r.raise_for_status()
        update_file_metadata(fid, r)
        tot = int(r.headers.get('content-length', 0))
        supports_range = r.headers.get('accept-ranges') == 'bytes' or r.headers.get('Content-Range') or r.headers.get('content-length')
        r.close()
        
        with db_lock: 
            db[fid]['total'] = tot
            name = db[fid]['name']
        
        if tot == 0 or not supports_range:
            drive_worker(fid)
            return
            
        mt = mimetypes.guess_type(name)[0] or 'application/octet-stream'
        meta = {'name': name}
        init_res = drive_api_session.post(
            'https://www.googleapis.com/upload/drive/v3/files?uploadType=resumable',
            headers={'Authorization': f'Bearer {token}', 'Content-Type': 'application/json', 'X-Upload-Content-Type': mt, 'X-Upload-Content-Length': str(tot)},
            json=meta, timeout=30
        )
        init_res.raise_for_status()
        upload_url = init_res.headers['Location']
        
        chunk_size = 67108864 # 64MB Gigabit Buffer chunking
        max_workers = 16 
        session = requests.Session()
        adapter = requests.adapters.HTTPAdapter(pool_connections=max_workers*2, pool_maxsize=max_workers*2)
        session.mount('http://', adapter); session.mount('https://', adapter)
        buffer = {}
        cv = threading.Condition()
        stop_event = threading.Event()
        
        total_chunks = (tot + chunk_size - 1) // chunk_size

        def fetch(idx):
            if stop_event.is_set(): return
            sb = idx * chunk_size
            eb = min(sb + chunk_size - 1, tot - 1)
            th = HEADERS.copy(); th['Range'] = f'bytes={sb}-{eb}'
            for _ in range(5):
                try:
                    res = session.get(u, headers=th, timeout=(5, 30))
                    if res.status_code in [200, 206]:
                        with cv: 
                            buffer[idx] = res.content
                            cv.notify_all()
                        return
                except: time.sleep(0.5)
            with cv: 
                buffer[idx] = b'ERR'
                cv.notify_all()

        executor = concurrent.futures.ThreadPoolExecutor(max_workers=max_workers)
        for i in range(min(max_workers, total_chunks)): executor.submit(fetch, i)

        curr = 0
        file_id = None
        try:
            while curr < total_chunks:
                with cv:
                    while curr not in buffer:
                        with db_lock:
                            if db[fid]['status'] == 'Stopped': 
                                stop_event.set()
                                raise Exception("Stopped by user")
                        cv.wait(0.5)
                    data = buffer.pop(curr)
                    
                if data == b'ERR': raise Exception("Chunk download failed in Swarm")
                
                start_byte = curr * chunk_size
                end_byte = start_byte + len(data) - 1
                headers = {'Content-Range': f'bytes {start_byte}-{end_byte}/{tot}', 'Content-Length': str(len(data))}
                
                success = False
                for _ in range(5):
                    try:
                        res = drive_api_session.put(upload_url, data=data, headers=headers, timeout=120)
                        if res.status_code in [308, 200, 201]:
                            if res.status_code in [200, 201]: file_id = res.json().get('id')
                            success = True
                            break
                    except: time.sleep(2)
                    
                if not success: raise Exception("Swarm Google Drive Upload rejected.")
                    
                with db_lock: db[fid]['down'] += len(data)
                
                next_fetch = curr + max_workers
                if next_fetch < total_chunks: executor.submit(fetch, next_fetch)
                curr += 1
                
            with db_lock:
                if db[fid]['status'] != 'Stopped': 
                    db[fid]['status'] = 'Completed'
                    db[fid]['type'] = 'drive_direct'
                    db[fid]['file_id'] = file_id
        finally:
            stop_event.set()
            executor.shutdown(wait=False, cancel_futures=True)

    except Exception as e:
        with db_lock: db[fid]['status'] = f'Error: {str(e)[:40]}'

