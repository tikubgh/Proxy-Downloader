CHUNK_SIZE_MULTI = 1048576 * 4

@app.route('/dl/<fid>/<path:fname>', methods=['GET', 'HEAD'])
def download(fid,fname):
 with db_lock:
  if fid not in db or not os.path.exists(db[fid]['path']): return "404",404
  f=db[fid]; fp=f['path']; ts=f.get('total',0); st=f['status']; nm=f['name']
 
 mt,_=mimetypes.guess_type(nm); mt=mt or 'application/octet-stream'
 disp = 'inline' if mt.startswith(('video/', 'audio/')) else 'attachment'
 
 if st=='Completed' and ts==0:
  ts=os.path.getsize(fp)
  with db_lock: db[fid]['total']=ts
 
 last_mod = time.strftime('%a, %d %b %Y %H:%M:%S GMT', time.gmtime(f.get('start', time.time())))
 etag = f'"{fid}-{ts}"'

 encoded_name = urllib.parse.quote(nm)
 disp_header = f"{disp}; filename*=UTF-8''{encoded_name}"

 if ts==0:
  hdrs = {'Content-Type': mt, 'Content-Disposition': disp_header}
  if request.method == 'HEAD': return Response(status=200, headers=hdrs)
  def gen_unk():
   with open(fp,'rb') as lf:
    while True:
     c=lf.read(STREAM_CHUNK_SIZE)
     if c: yield c
     else:
      with db_lock: cst=db[fid]['status']
      if cst not in ['Completed','Stopped'] and 'Error' not in cst: 
       time.sleep(0.5)
       lf.seek(lf.tell())
      else: break
  return Response(gen_unk(),status=200,headers=hdrs)
 
 rh=request.headers.get('Range',None); sb=0; eb=ts-1 if ts else 0
 if rh and ts:
  m=re.search(r'bytes=(\d+)-(\d*)',rh)
  if m: sb=int(m.group(1)); eb=int(m.group(2)) if m.group(2) else eb
 l=eb-sb+1
 
 hdrs={'Content-Type':mt,'Content-Disposition':disp_header,'Accept-Ranges':'bytes', 'ETag': etag, 'Last-Modified': last_mod}
 if ts: hdrs.update({'Content-Length':str(l),'Content-Range':f'bytes {sb}-{eb}/{ts}'})
 
 if request.method == 'HEAD': return Response(status=206 if rh else 200, headers=hdrs)

 def gen():
  with open(fp,'rb') as lf:
   lf.seek(sb)
   bytes_read = 0
   while bytes_read < l:
    with db_lock:
     if fid not in db: break
     cst = db[fid]['status']
     ftype = db[fid]['type']
     written = db[fid].get('written', set())
     src_url = db[fid].get('url')
    
    if cst in ['Completed', 'Stopped'] or 'Error' in cst:
     c = lf.read(min(STREAM_CHUNK_SIZE, l - bytes_read))
     if c:
      yield c
      bytes_read += len(c)
     else: break
     continue
     
    can_read = False
    curr_pos = lf.tell()
    
    if ftype in ['disk', 'drive_swarm']:
     if os.path.getsize(fp) > curr_pos: can_read = True
    elif ftype == 'multi':
     chunk_start = (curr_pos // CHUNK_SIZE_MULTI) * CHUNK_SIZE_MULTI
     chunk_idx = curr_pos // CHUNK_SIZE_MULTI
     if chunk_start in written: 
      can_read = True
     else:
      with db_lock:
       if 'priority' in db[fid]: db[fid]['priority'].add(chunk_idx)
    else:
     can_read = True

    if can_read:
     c = lf.read(min(STREAM_CHUNK_SIZE, l - bytes_read))
     if c:
      yield c
      bytes_read += len(c)
      continue
    elif ftype in ['disk', 'drive_swarm'] and src_url:
     req_size = min(1048576, l - bytes_read)
     success_proxy = False
     try:
      ph = HEADERS.copy()
      ph['Range'] = f'bytes={curr_pos}-{curr_pos + req_size - 1}'
      with requests.get(src_url, headers=ph, timeout=10, stream=True) as pr:
       if pr.status_code == 206:
        for chunk in pr.iter_content(chunk_size=STREAM_CHUNK_SIZE):
         if chunk:
          yield chunk
          bytes_read += len(chunk)
          success_proxy = True
     except: pass
     if success_proxy:
      lf.seek(sb + bytes_read)
      continue
      
    time.sleep(0.5)
    lf.seek(curr_pos)
 return Response(gen(),status=206 if rh else 200,headers=hdrs)

