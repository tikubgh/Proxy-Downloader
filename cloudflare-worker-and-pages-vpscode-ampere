            for line in f:
                if ':' in line:
                    parts = line.split(':')[1].split()
                    if len(parts) >= 16:
                        rx_bytes += int(parts[0])
                        tx_bytes += int(parts[8])
    except: pass
    
    rx_speed = max((rx_bytes - vpn_stats_prev['rx']) / dt / (1024**2), 0) if vpn_stats_prev['rx'] > 0 else 0
    tx_speed = max((tx_bytes - vpn_stats_prev['tx']) / dt / (1024**2), 0) if vpn_stats_prev['tx'] > 0 else 0
    vpn_stats_prev = {'t': now, 'rx': rx_bytes, 'tx': tx_bytes}
    
    peers = []
    try:
        cmd = f"ss -tuni '( sport = :{VPN_PORT} )' 2>/dev/null"
        out = subprocess.check_output(cmd, shell=True, text=True)
        for line in out.splitlines()[1:]:
            parts = line.split()
            if len(parts) >= 5:
                proto = parts[0].upper()
                recv_q = parts[1]
                send_q = parts[2]
                peer_part = parts[4] if len(parts) > 4 else ""
                if ':' in peer_part:
                    ip = peer_part.rsplit(':', 1)[0].replace('[', '').replace(']', '')
                    port = peer_part.rsplit(':', 1)[1]
                    if ip not in ['0.0.0.0', '127.0.0.1', '*', '::']:
                        peers.append({'ip': ip, 'port': port, 'proto': proto, 'recv_q': recv_q, 'send_q': send_q})
    except: pass
    
    srv_ip = request.host.split(':')[0]
    out_b64 = base64.b64encode(f"chacha20-ietf-poly1305:{VPN_PASS}".encode()).decode()
    ss_link = f"ss://{out_b64}@{srv_ip}:{VPN_PORT}#10GBPS-VPN"
    outline_link = f"ss://{out_b64}@{srv_ip}:{VPN_PORT}/?outline=1#10GBPS-VPN"
    
    return jsonify({
        'rx_speed': f"{rx_speed:.2f} MB/s",
        'tx_speed': f"{tx_speed:.2f} MB/s",
        'peer_count': len(peers),
        'peers': peers,
        'port': VPN_PORT,
        'server_ip': srv_ip,
        'ss_link': ss_link,
        'outline_link': outline_link
    })

