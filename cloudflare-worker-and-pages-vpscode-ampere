        parts_count = (end - start + part_size) // part_size
        data = b''.join(list(self.executor.map(fetch_part, range(parts_count))))
        with shared_drive_lock:
            shared_drive_cache[ck] = data
            while len(shared_drive_cache) > 32: shared_drive_cache.popitem(last=False)
        return data
    def close(self):
        if hasattr(self, 'executor'): self.executor.shutdown(wait=False)

