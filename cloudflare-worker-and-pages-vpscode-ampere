 with db_lock:
  if fid not in db or db[fid]['type'] not in ['p2p', 'disk_relay']: return "404",404
  f=db[fid]; ftype=f['type']; ts=f.get('total', 0)

 last_mod = time.strftime('%a, %d %b %Y %H:%M:%S GMT', time.gmtime(f.get('start', time.time())))
 etag = f'"{fid}-{ts}"'
 mt = mimetypes.guess_type(f['name'])[0] or 'application/octet-stream'
 disp = 'inline' if mt.startswith(('video/', 'audio/')) else 'attachment'

 rh = request.headers.get('Range')
 sb = 0
 eb = ts - 1 if ts > 0 else 0
 is_range = False

 if rh:
  m = re.search(r'bytes=(\d+)-(\d*)', rh)
  if m:
   sb = int(m.group(1))
   if m.group(2): eb = int(m.group(2))
   is_range = True

 hdrs = {
  'Accept-Ranges': 'bytes',
  'ETag': etag,
  'Last-Modified': last_mod,
  'Cache-Control': 'no-cache, no-store, must-revalidate',
  'X-Accel-Buffering': 'no',
  'Access-Control-Allow-Origin': '*'
 }

 if request.method == 'HEAD':
  hdrs['Content-Type'] = mt
  if ts > 0: hdrs['Content-Length'] = str(ts)
