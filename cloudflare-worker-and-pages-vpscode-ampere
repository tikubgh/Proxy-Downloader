            db[fid]['written'] = set()
            p = db[fid]['path']

        if tot == 0 or not supports_range:
            dl_worker(fid) 
            return

        with open(p, 'wb') as f: f.truncate(tot)
        fd = os.open(p, os.O_WRONLY) 

        MAX_CONNECTIONS = 128
        chunk_size = max(2097152, min(8388608, tot // MAX_CONNECTIONS))
        
        tasks = queue.PriorityQueue() 
        for i in range((tot + chunk_size - 1) // chunk_size):
            start = i * chunk_size
            end = min(start + chunk_size - 1, tot - 1)
            tasks.put((start, start, end)) 

        error_flag = []
        
        def worker():
            local_session = requests.Session()
            adapter = requests.adapters.HTTPAdapter(pool_connections=1, pool_maxsize=1)
            local_session.mount('http://', adapter)
            local_session.mount('https://', adapter)

            while True:
                if error_flag: break
                
                # Hard Interrupt Check
                with db_lock:
                    if fid not in db or db[fid].get('status') == 'Stopped': 
                        error_flag.append(True)
                        break
                
                try:
                    _, start_byte, end_byte = tasks.get_nowait()
                except queue.Empty:
                    break 

                h = HEADERS.copy()
                h['Range'] = f'bytes={start_byte}-{end_byte}'
                
                current_offset = start_byte
                chunk_success = False

                with db_lock: 
                    if fid in db: db[fid]['active_threads'] += 1
                    
                try:
                    with local_session.get(u, headers=h, timeout=(5, 15), stream=True) as res:
                        if res.status_code in [403, 429, 503, 508]:
                            raise ValueError(f"HTTP {res.status_code}")
                        res.raise_for_status()
                        
                        for chunk_data in res.iter_content(chunk_size=262144):
                            # Hard Interrupt Check Inside Download Bytes Loop
                            with db_lock:
                                if fid not in db or db[fid].get('status') == 'Stopped':
                                    error_flag.append(True)
                                    raise Exception("Aborted")
                            
                            if chunk_data:
                                os.pwrite(fd, chunk_data, current_offset)
                                current_offset += len(chunk_data)
                                with db_lock: 
                                    if fid in db:
                                        db[fid]['down'] += len(chunk_data)

                    chunk_success = True

                except Exception as ex:
                    pass 
                finally:
                    with db_lock: 
                        if fid in db: db[fid]['active_threads'] -= 1
                    
                    if not chunk_success and current_offset <= end_byte and not error_flag:
                        time.sleep(0.5) 
                        tasks.put((current_offset, current_offset, end_byte))
                    
                    tasks.task_done()
            
            local_session.close()

        worker_threads = []
        for _ in range(MAX_CONNECTIONS):
            t = threading.Thread(target=worker)
            t.start()
            worker_threads.append(t)
            time.sleep(0.01) 
            
        # Smart wait that allows instant breakage
        while not tasks.empty() and not error_flag:
            with db_lock:
                if fid not in db or db[fid].get('status') == 'Stopped':
                    error_flag.append(True)
            time.sleep(1)
            
        if not error_flag:
            tasks.join()
        
        error_flag.append(True)
        for t in worker_threads: t.join()
        
        os.close(fd) 
        
        with db_lock:
            is_aborted = fid not in db or db[fid].get('status') == 'Stopped'
            
        if is_aborted:
            try: os.remove(p)
            except: pass
        else:
            with db_lock:
                if fid in db:
                    db[fid]['active_threads'] = 0
                    db[fid]['status'] = 'Completed'

    except Exception as e:
        with db_lock: 
            if fid in db: db[fid]['status'] = f'Error: {str(e)[:40]}'

