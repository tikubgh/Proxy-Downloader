@app.route('/swarm_dl/<fid>/<path:fname>', methods=['GET', 'HEAD'])
def swarm_dl(fid, fname):
    with db_lock:
        if fid not in db or db[fid]['type'] != 'swarm': return "404", 404
        u = db[fid]['url']
        ts = db[fid].get('total', 0)
        nm = db[fid]['name']
    mt, _ = mimetypes.guess_type(nm)
    mt = mt or 'application/octet-stream'
    rh = request.headers.get('Range', None)
    user_start = 0
    user_end = ts - 1 if ts else None
    is_range = False
    
    if rh and ts:
        m = re.search(r'bytes=(\d+)-(\d*)', rh)
        if m:
            user_start = int(m.group(1))
            if m.group(2): user_end = int(m.group(2))
            is_range = True
            
    if request.method == 'HEAD':
        hdrs = {'Content-Type': mt, 'Accept-Ranges': 'bytes', 'Content-Disposition': f"attachment; filename=\"{urllib.parse.quote(nm)}\"; filename*=UTF-8''{urllib.parse.quote(nm)}"}
        if ts: hdrs['Content-Length'] = str(ts)
        return Response(status=206 if is_range else 200, headers=hdrs)
        
    req_length = (user_end - user_start + 1) if ts else 0
    if is_range and req_length > 0 and req_length <= 20971520:
        def generate_direct():
            th = HEADERS.copy()
            th['Range'] = f'bytes={user_start}-{user_end}'
            try:
                with requests.get(u, headers=th, stream=True, timeout=10) as r:
                    for chunk in r.iter_content(STREAM_CHUNK_SIZE):
                        if chunk: yield chunk
            except:
                pass
        hdrs = {'Content-Type': mt, 'Accept-Ranges': 'bytes', 'Cache-Control': 'no-store'}
        if ts: hdrs.update({'Content-Length': str(req_length), 'Content-Range': f'bytes {user_start}-{user_end}/{ts}'})
        return Response(generate_direct(), status=206, headers=hdrs)
        
    if ts == 0:
        try:
            r = requests.get(u, headers=HEADERS, stream=True, timeout=10)
            return Response((c for c in r.iter_content(STREAM_CHUNK_SIZE) if c), status=200, headers={'Content-Type': mt})
        except:
            return "Error", 500
            
    def generate_swarm():
        chunk_size = 2097152
        max_workers = 8
        session = requests.Session()
        adapter = requests.adapters.HTTPAdapter(pool_connections=max_workers*2, pool_maxsize=max_workers*2)
        session.mount('http://', adapter)
        session.mount('https://', adapter)
        buffer = {}
        cv = threading.Condition()
        stop_event = threading.Event()
        start_idx = user_start // chunk_size
        end_idx = user_end // chunk_size if user_end else (ts - 1) // chunk_size
        
        def fetch(idx):
            if stop_event.is_set(): return
            sb = idx * chunk_size
            eb = min(sb + chunk_size - 1, user_end if user_end else ts - 1)
            th = HEADERS.copy()
            th['Range'] = f'bytes={sb}-{eb}'
            for _ in range(5):
                try:
                    r = session.get(u, headers=th, timeout=(5, 15))
                    if r.status_code in [200, 206]:
                        with cv:
                            buffer[idx] = r.content
                            cv.notify_all()
                        return
                except:
                    time.sleep(0.5)
            with cv:
                buffer[idx] = b'ERR'
                cv.notify_all()
                
        executor = concurrent.futures.ThreadPoolExecutor(max_workers=max_workers)
        for i in range(start_idx, min(start_idx + max_workers, end_idx + 1)): executor.submit(fetch, i)
        curr = start_idx
        try:
            while curr <= end_idx:
                with cv:
                    while curr not in buffer:
                        with db_lock:
                            if fid not in db or db[fid].get('status') == 'Stopped':
                                stop_event.set()
                                return
                        cv.wait(0.5)
                    data = buffer.pop(curr)
                if data == b'ERR': break
                next_fetch = curr + max_workers
                if next_fetch <= end_idx: executor.submit(fetch, next_fetch)
                if curr == start_idx and user_start % chunk_size != 0: yield data[user_start % chunk_size:]
                else: yield data
                curr += 1
        finally:
            stop_event.set()
            executor.shutdown(wait=False, cancel_futures=True)
            
    hdrs = {'Content-Type': mt, 'Accept-Ranges': 'bytes', 'Cache-Control': 'no-store'}
    if ts: hdrs.update({'Content-Length': str(req_length), 'Content-Range': f'bytes {user_start}-{user_end}/{ts}'})
    return Response(generate_swarm(), status=206 if rh else 200, headers=hdrs)

