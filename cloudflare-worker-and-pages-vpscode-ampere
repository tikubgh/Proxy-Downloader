 def generate_swarm():
  chunk_size = 1024 * 1024 
  max_workers = 32
  session = requests.Session()
  adapter = requests.adapters.HTTPAdapter(pool_connections=max_workers*2, pool_maxsize=max_workers*2)
  session.mount('http://', adapter); session.mount('https://', adapter)
  buffer = {}; cv = threading.Condition(); stop_event = threading.Event()
  start_idx = user_start // chunk_size
  end_idx = user_end // chunk_size if user_end else (ts - 1) // chunk_size

  def fetch(idx):
   if stop_event.is_set(): return
   sb = idx * chunk_size
   eb = min(sb + chunk_size - 1, user_end if user_end else ts - 1)
   th = HEADERS.copy(); th['Range'] = f'bytes={sb}-{eb}'
   for _ in range(5):
    try:
     r = session.get(u, headers=th, timeout=(3, 10))
     if r.status_code in [200, 206]:
