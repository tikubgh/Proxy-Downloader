        with db_lock:
            for fid in list(db.keys()):
                if db[fid].get('type') == 'vault': continue
                if now - db[fid].get('start', now) > 86400:
                    try: os.remove(db[fid]['path'])
                    except: pass
                    if fid in p2p_streams: p2p_streams[fid].chunks.clear(); del p2p_streams[fid]
                    if fid in disk_streams: del disk_streams[fid]
                    del db[fid]
