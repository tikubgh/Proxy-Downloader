def update_file_metadata(fid, r):
    cd = r.headers.get('content-disposition', '')
    new_name = None
    if cd:
        m = re.search(r"filename\s*\*=\s*UTF-8''([^;]+)", cd, re.IGNORECASE)
        if m: new_name = urllib.parse.unquote(m.group(1))
        else:
            m = re.search(r'filename\s*=\s*"([^"]+)"', cd, re.IGNORECASE)
            if m: new_name = m.group(1)
            else:
                m = re.search(r'filename\s*=\s*([^;]+)', cd, re.IGNORECASE)
                if m: new_name = m.group(1).strip(' \'"')
    if not new_name:
        path = urllib.parse.urlparse(r.url).path
        name = urllib.parse.unquote(os.path.basename(path))
        if name and '.' in name: new_name = name
        
    if new_name:
        new_name = urllib.parse.unquote(new_name)
        safe_name = re.sub(r'[\\/*?:"<>|]', "", new_name).strip()
        if safe_name:
            with db_lock:
                db[fid]['name'] = safe_name
                old_path = db[fid]['path']
                new_path = os.path.join(DL_DIR, f"{fid}_{safe_name}")
                db[fid]['path'] = new_path
                if os.path.exists(old_path) and old_path != new_path:
                    os.rename(old_path, new_path)

def dl_worker(fid):
    with db_lock:
        if fid not in db: return
        u = db[fid]['url']
    try:
        r = requests.get(u, stream=True, headers=HEADERS, timeout=15, allow_redirects=True)
        r.raise_for_status()
        update_file_metadata(fid, r)
        
        with db_lock:
            p = db[fid]['path']
            tot = int(r.headers.get('content-length', 0))
            db[fid]['total'] = tot
            
        with open(p, 'wb') as f:
            for c in r.iter_content(1048576):
                with db_lock:
                    if db[fid]['status'] == 'Stopped': 
                        r.close()
                        return
                if c:
                    f.write(c)
                    with db_lock: db[fid]['down'] += len(c)
        with db_lock:
            if db[fid]['status'] != 'Stopped': db[fid]['status'] = 'Completed'
        r.close()
    except Exception as e:
        with db_lock: db[fid]['status'] = f'Error: {str(e)[:40]}'

def multi_worker(fid):
    with db_lock:
        if fid not in db: return
        u = db[fid]['url']
    try:
        r = requests.get(u, headers=HEADERS, stream=True, timeout=15, allow_redirects=True)
        r.raise_for_status()
        update_file_metadata(fid, r)
        
        tot = int(r.headers.get('content-length', 0))
        supports_range = r.headers.get('accept-ranges') == 'bytes' or r.headers.get('Content-Range') or r.headers.get('content-length')
        r.close()
        
        with db_lock: 
            db[fid]['total'] = tot
            db[fid]['written'] = set()
            db[fid]['priority'] = set()
            p = db[fid]['path']
        
        if tot == 0 or not supports_range:
            dl_worker(fid)
            return
            
        with open(p, 'wb') as f: f.truncate(tot)
        
        total_chunks = (tot + CHUNK_SIZE_MULTI - 1) // CHUNK_SIZE_MULTI
        
        pending_chunks = set(range(total_chunks))
        active_chunks = set()
        lock = threading.Lock()
        file_write_lock = threading.Lock()
        error_flag = []
        
        def get_next_chunk():
            with lock:
                with db_lock:
                    pri = list(db[fid].get('priority', set()))
                for c in pri:
                    if c in pending_chunks and c not in active_chunks:
                        active_chunks.add(c)
                        return c
                for c in sorted(list(pending_chunks)):
                    if c not in active_chunks:
                        active_chunks.add(c)
                        return c
                return None

        def worker():
            while True:
                if error_flag: break
                with db_lock:
                    if fid not in db or db[fid]['status'] == 'Stopped': break
                    
                c_idx = get_next_chunk()
                if c_idx is None: break
                
                start = c_idx * CHUNK_SIZE_MULTI
                end = min(start + CHUNK_SIZE_MULTI - 1, tot - 1)
                h = HEADERS.copy(); h['Range'] = f'bytes={start}-{end}'
                success = False
                
                for _ in range(5):
                    try:
                        res = requests.get(u, headers=h, timeout=15, allow_redirects=True)
                        res.raise_for_status()
                        
                        with file_write_lock:
                            with open(p, 'r+b') as f:
                                f.seek(start)
                                f.write(res.content)
                                
                        with db_lock: 
                            if fid in db:
                                db[fid]['down'] += len(res.content)
                                db[fid]['written'].add(start)
                                if 'priority' in db[fid] and c_idx in db[fid]['priority']:
                                    db[fid]['priority'].remove(c_idx)
                                
                        with lock:
                            pending_chunks.remove(c_idx)
                            active_chunks.remove(c_idx)
                        success = True
                        break
                    except Exception:
                        time.sleep(1)
                        
                if not success:
                    error_flag.append(True)
                    break
                    
        threads = []
        for _ in range(8):
            t = threading.Thread(target=worker)
            t.start()
            threads.append(t)
            
        for t in threads: t.join()
                
        with db_lock:
            if fid in db:
                if db[fid]['status'] != 'Stopped' and not error_flag:
                    db[fid]['status'] = 'Completed'
                elif error_flag:
                    db[fid]['status'] = 'Error: Connection Refused'
                
    except Exception as e:
        with db_lock: 
            if fid in db: db[fid]['status'] = f'Error: {str(e)[:40]}'

