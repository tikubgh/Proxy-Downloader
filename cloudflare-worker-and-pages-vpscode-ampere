    if not u: return "Err", 400
    u = u.strip()[1:-1] if u.strip().startswith('<') and u.strip().endswith('>') else u.strip()
    if not u.startswith('http'): u = 'https://' + u
    fid = str(uuid.uuid4())[:8]
