@app.route('/api/action/<fid>/<act>')
def action(fid,act):
 with db_lock:
  if fid not in db: return "OK"
  if act=='stop':
   # Flag as stopped to trigger Hard Interrupt in active workers
   db[fid]['status']='Stopped'
   ftype = db[fid].get('type')
   path_to_del = db[fid].get('path')
   
   # 1. Execute "Close Player" Unified Cleanup 
   streams_to_kill = db[fid].get('hls_streams', set())
   for sid in list(streams_to_kill):
       if sid in hls_procs:
           try:
               hls_procs[sid].terminate()
               hls_procs[sid].wait(timeout=2)
           except:
               try: hls_procs[sid].kill()
               except: pass
           del hls_procs[sid]
       shutil.rmtree(os.path.join(HLS_DIR, sid), ignore_errors=True)
   
   # 2. Stop Active Transcoding Processes
   if fid in active_procs:
    try: active_procs[fid].kill() if hasattr(active_procs[fid],'kill') else active_procs[fid].set(); del active_procs[fid]
    except: pass
    
   # 3. Clean up P2P and Disk Streams instantly
   if ftype == 'p2p' and fid in p2p_streams:
    with p2p_streams[fid].lock: p2p_streams[fid].cond.notify_all()
    p2p_streams[fid].chunks.clear() 
    del p2p_streams[fid]
   elif ftype == 'disk_relay' and fid in disk_streams:
    with disk_streams[fid].lock: disk_streams[fid].cond.notify_all()
    del disk_streams[fid]
     
   # 4. Instantly remove from DB so it clears from the UI Grid
   del db[fid]
   
   # 5. Background Daemon ensures safe deletion after thread file-locks are freed
   def delayed_delete(p):
       time.sleep(2.0)
       try: os.remove(p)
