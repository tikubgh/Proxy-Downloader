@app.route('/api/start_hls')
def start_hls():
    target_url = request.args.get('url')
    if not target_url: return jsonify({'error': 'No URL'}), 400
    
    stream_id = hashlib.md5(target_url.encode()).hexdigest()
    stream_dir = os.path.join(HLS_DIR, stream_id)
    
    parsed = urllib.parse.urlparse(target_url)
    local_url = f"http://127.0.0.1:8080{parsed.path}"
    if parsed.query: local_url += f"?{parsed.query}"

    if stream_id not in hls_procs or hls_procs[stream_id].poll() is not None:
        os.makedirs(stream_dir, exist_ok=True)
        for f in os.listdir(stream_dir): 
            try: os.remove(os.path.join(stream_dir, f))
            except: pass
            
        cmd = [
            'ffmpeg', '-hide_banner', '-loglevel', 'error',
            '-reconnect', '1', '-reconnect_streamed', '1', '-reconnect_delay_max', '5',
            '-i', local_url,
            '-c:v', 'copy',
            '-c:a', 'aac', '-ac', '2', '-b:a', '256k',
            '-f', 'hls',
            '-hls_time', '4',
            '-hls_list_size', '0', 
            '-hls_playlist_type', 'event',
            '-start_at_zero', 
            '-avoid_negative_ts', 'make_zero',
            '-hls_segment_filename', os.path.join(stream_dir, 'seg_%04d.ts'),
            os.path.join(stream_dir, 'index.m3u8')
        ]
        hls_procs[stream_id] = subprocess.Popen(cmd)
        
        for _ in range(150):
            if os.path.exists(os.path.join(stream_dir, 'index.m3u8')): break
            time.sleep(0.1)

    return jsonify({'playlist_url': f'/hls/{stream_id}/index.m3u8', 'stream_id': stream_id})

@app.route('/api/stop_hls')
def stop_hls():
    stream_id = request.args.get('stream_id')
    if stream_id and stream_id in hls_procs:
        try:
            hls_procs[stream_id].terminate()
            hls_procs[stream_id].wait(timeout=2)
        except:
            try: hls_procs[stream_id].kill()
            except: pass
        del hls_procs[stream_id]
        
        stream_dir = os.path.join(HLS_DIR, stream_id)
        shutil.rmtree(stream_dir, ignore_errors=True)
    return jsonify({'success': True})

