                    res = drive_api_session.put(upload_url, data=data_bytes, headers=headers, timeout=120)
                    if res.status_code in [308, 200, 201]:
                        if res.status_code in [200, 201]: file_id = res.json().get('id')
                        start_byte += chunk_len
                        with db_lock:
                            if fid in db: db[fid]['down'] = start_byte
                        return True
                except:
                    time.sleep(2)
            return False
            
        for chunk in r_head.iter_content(chunk_size=4194304):
            with db_lock:
                if fid not in db or db[fid].get('status') == 'Stopped':
                    r_head.close()
                    raise Exception("Stopped by user")
            if chunk:
                buf.extend(chunk)
                while len(buf) >= chunk_size:
                    c_data = bytes(buf[:chunk_size])
                    del buf[:chunk_size]
                    if not upload_chunk(c_data): raise Exception("Drive chunk upload rejected after 5 retries.")
        if buf:
            if not upload_chunk(bytes(buf)): raise Exception("Final Drive chunk upload rejected.")
        with db_lock:
            if fid in db and db[fid]['status'] != 'Stopped':
                db[fid]['status'] = 'Completed'
                db[fid]['type'] = 'drive_direct'
                db[fid]['file_id'] = file_id
    except Exception as e:
        with db_lock:
            if fid in db: db[fid]['status'] = f'Error: {str(e)[:40]}'

def drive_swarm_worker(fid):
    with db_lock:
        if fid not in db: return
        u = db[fid]['url']
        db[fid]['status'] = 'Swarm Piping to Drive (RAM)...'
        db[fid]['active_threads'] = 0
    try:
        token, err = get_drive_auth()
        if err: raise Exception(err)
        r = requests.get(u, headers=HEADERS, stream=True, timeout=15, allow_redirects=True)
        r.raise_for_status()
        update_file_metadata(fid, r)
        tot = int(r.headers.get('content-length', 0))
        supports_range = r.headers.get('accept-ranges') == 'bytes' or r.headers.get('Content-Range') or r.headers.get('content-length')
        r.close()
        with db_lock:
            if fid not in db: return
            db[fid]['total'] = tot
            name = db[fid]['name']
        if tot == 0 or not supports_range:
            drive_worker(fid)
            return
        mt = mimetypes.guess_type(name)[0] or 'application/octet-stream'
        meta = {'name': name}
        init_res = drive_api_session.post('https://www.googleapis.com/upload/drive/v3/files?uploadType=resumable', headers={'Authorization': f'Bearer {token}', 'Content-Type': 'application/json', 'X-Upload-Content-Type': mt, 'X-Upload-Content-Length': str(tot)}, json=meta, timeout=30)
        init_res.raise_for_status()
        upload_url = init_res.headers['Location']
        chunk_size = 33554432
        max_workers = 8
        session = requests.Session()
        adapter = requests.adapters.HTTPAdapter(pool_connections=max_workers*2, pool_maxsize=max_workers*2)
        session.mount('http://', adapter)
        session.mount('https://', adapter)
        buffer = {}
        cv = threading.Condition()
        stop_event = threading.Event()
        total_chunks = (tot + chunk_size - 1) // chunk_size
        
        def fetch(idx):
            if stop_event.is_set(): return
            sb = idx * chunk_size
            eb = min(sb + chunk_size - 1, tot - 1)
            th = HEADERS.copy()
            th['Range'] = f'bytes={sb}-{eb}'
            for _ in range(5):
                with db_lock:
                    if fid in db: db[fid]['active_threads'] += 1
                try:
                    res = session.get(u, headers=th, timeout=(5, 30))
                    if res.status_code in [200, 206]:
                        with cv:
                            buffer[idx] = res.content
                            cv.notify_all()
                        with db_lock:
                            if fid in db: db[fid]['active_threads'] -= 1
                        return
                except:
                    time.sleep(0.5)
                with db_lock:
                    if fid in db: db[fid]['active_threads'] -= 1
            with cv:
                buffer[idx] = b'ERR'
                cv.notify_all()
                
        executor = concurrent.futures.ThreadPoolExecutor(max_workers=max_workers)
        for i in range(min(max_workers, total_chunks)): executor.submit(fetch, i)
        curr = 0
        file_id = None
        try:
            while curr < total_chunks:
                with cv:
                    while curr not in buffer:
                        with db_lock:
                            if fid not in db or db[fid].get('status') == 'Stopped':
                                stop_event.set()
                                raise Exception("Stopped by user")
                        cv.wait(0.5)
                    data = buffer.pop(curr)
                if data == b'ERR': raise Exception("Chunk download failed in Swarm")
                start_byte = curr * chunk_size
                end_byte = start_byte + len(data) - 1
                headers = {'Content-Range': f'bytes {start_byte}-{end_byte}/{tot}', 'Content-Length': str(len(data))}
                success = False
                for _ in range(5):
                    try:
                        res = drive_api_session.put(upload_url, data=data, headers=headers, timeout=120)
                        if res.status_code in [308, 200, 201]:
                            if res.status_code in [200, 201]: file_id = res.json().get('id')
                            success = True
                            break
                    except:
                        time.sleep(2)
                if not success: raise Exception("Swarm Google Drive Upload rejected.")
                with db_lock:
                    if fid in db: db[fid]['down'] += len(data)
                del data
                gc.collect()
                next_fetch = curr + max_workers
                if next_fetch < total_chunks: executor.submit(fetch, next_fetch)
                curr += 1
                
            with db_lock:
                if fid in db:
                    db[fid]['active_threads'] = 0
                    if db[fid]['status'] != 'Stopped':
                        db[fid]['status'] = 'Completed'
                        db[fid]['type'] = 'drive_direct'
                        db[fid]['file_id'] = file_id
        finally:
            stop_event.set()
            executor.shutdown(wait=False, cancel_futures=True)
    except Exception as e:
        with db_lock:
            if fid in db: db[fid]['status'] = f'Error: {str(e)[:40]}'

@app.route('/api/add')
def add():
    u = request.args.get('url')
    t = request.args.get('type', 'disk')
    if not u: return "Err", 400
    u = str(u).strip()
    if u.startswith('<') and u.endswith('>'): u = u[1:-1]
    if '<' in u and '>' in u:
        m = re.search(r'(?:src|href)=["\']([^"\']+)["\']', u, re.IGNORECASE)
        if m: u = m.group(1)
    if not u.startswith('http://') and not u.startswith('https://'): u = 'https://' + u
    fid = str(uuid.uuid4())[:8]
    with db_lock:
        db[fid] = {'id': fid, 'url': u, 'name': f"file_{fid}.bin", 'path': os.path.join(DL_DIR, f"file_{fid}.bin"), 'down': 0, 'total': 0, 'status': 'Starting...', 'start': time.time(), 'type': t}
    if t == 'disk': threading.Thread(target=dl_worker, args=(fid,)).start()
    elif t == 'multi': threading.Thread(target=multi_worker, args=(fid,)).start()
    elif t == 'ram': threading.Thread(target=ram_worker, args=(fid,)).start()
    elif t == 'swarm': threading.Thread(target=swarm_worker, args=(fid,)).start()
    elif t == 'drive': threading.Thread(target=drive_worker, args=(fid,)).start()
    elif t == 'drive_swarm': threading.Thread(target=drive_swarm_worker, args=(fid,)).start()
    elif t == 'drive_direct': threading.Thread(target=drive_direct_worker, args=(fid,)).start()
    return "OK"

@app.route('/api/action/<fid>/<act>')
def action(fid, act):
    with db_lock:
        if fid not in db: return "OK"
        if act == 'stop':
            db[fid]['status'] = 'Stopped'
            ftype = db[fid].get('type')
            path_to_del = db[fid].get('path')
            streams_to_kill = db[fid].get('hls_streams', set())
            for sid in list(streams_to_kill):
                if sid in hls_procs:
                    try:
                        hls_procs[sid].terminate()
                        hls_procs[sid].wait(timeout=2)
                    except:
                        try:
                            hls_procs[sid].kill()
                        except:
                            pass
                    del hls_procs[sid]
                shutil.rmtree(os.path.join(HLS_DIR, sid), ignore_errors=True)
            if fid in active_procs:
                try:
                    active_procs[fid].kill() if hasattr(active_procs[fid], 'kill') else active_procs[fid].set()
                    del active_procs[fid]
                except:
                    pass
            if ftype == 'p2p' and fid in p2p_streams:
                with p2p_streams[fid].lock: p2p_streams[fid].cond.notify_all()
                p2p_streams[fid].chunks.clear()
                del p2p_streams[fid]
            elif ftype == 'disk_relay' and fid in disk_streams:
                with disk_streams[fid].lock: disk_streams[fid].cond.notify_all()
                del disk_streams[fid]
            del db[fid]
            
            def delayed_delete(p):
                time.sleep(2.0)
                try:
                    os.remove(p)
                except:
                    pass
            if path_to_del: threading.Thread(target=delayed_delete, args=(path_to_del,), daemon=True).start()
    gc.collect()
    return "OK"

