@app.route('/stream/<fid>/<path:fname>', methods=['GET', 'HEAD'])
def unified_stream(fid, fname):
    with db_lock:
        if fid not in db: return "404", 404
        fobj = db[fid]
    
    ftype, mt, rh = fobj.get('type'), 'application/octet-stream', request.headers.get('Range')

    def get_range_bounds(ts):
        sb, eb = 0, ts - 1 if ts else 0
        if rh and ts:
            m = re.search(r'bytes=(\d+)-(\d*)', rh)
            if m: sb, eb = int(m.group(1)), int(m.group(2)) if m.group(2) else eb
        return sb, eb

    if ftype == 'p2p':
        st = p2p_streams.get(fid)
        if not st: return "404", 404
        st.connected = True; ts = fobj.get('total', 0)
        sb, eb = get_range_bounds(ts)
        hdrs = {'Content-Type': mt, 'Accept-Ranges': 'bytes', 'Content-Disposition': f'attachment; filename="{urllib.parse.quote(fname)}"', 'X-Accel-Buffering': 'no'}
        if ts: hdrs.update({'Content-Length': str(eb - sb + 1), 'Content-Range': f'bytes {sb}-{eb}/{ts}'})
        if request.method == 'HEAD': return Response(status=206 if rh else 200, headers=hdrs)
        
        def gen_p2p():
            start_idx, end_idx, offset = sb // P2P_CHUNK_SIZE, eb // P2P_CHUNK_SIZE, sb % P2P_CHUNK_SIZE
            for idx in range(start_idx, end_idx + 1):
                with st.lock: st.needed.add(idx)
                wait_time = 0
                while True:
                    with st.lock:
                        if idx in st.chunks: chunk = st.chunks[idx]; break
                    with db_lock:
                        if db.get(fid, {}).get('status') == 'Stopped': return
                    time.sleep(0.5); wait_time += 0.5
                    if wait_time > 60: return
                if idx == start_idx and idx == end_idx: yield chunk[offset : offset + (eb - sb + 1)]
                elif idx == start_idx: yield chunk[offset:]
                elif idx == end_idx: yield chunk[: (eb % P2P_CHUNK_SIZE) + 1]
                else: yield chunk
        return Response(gen_p2p(), status=206 if rh else 200, headers=hdrs)

    elif 'drive' in ftype:
        file_id = extract_drive_id(fobj.get('url', '')) if not fobj.get('file_id') else fobj.get('file_id')
        if not file_id: return "No Drive ID", 404
        token, err = get_drive_auth()
        if err: return "Auth Error", 403
        headers = {'Authorization': f'Bearer {token}', 'User-Agent': SPOOF_AGENT}
        if rh: headers['Range'] = rh
        r = drive_api_session.get(f'https://www.googleapis.com/drive/v3/files/{file_id}?alt=media&supportsAllDrives=true', headers=headers, stream=True, allow_redirects=True, timeout=15)
        register_download_conn(fid, r)
        def gen_drive():
            try:
                for ck in r.iter_content(STREAM_CHUNK_SIZE):
                    yield ck
            finally:
                unregister_download_conn(fid, r)
                r.close()
        resp = Response(gen_drive(), status=r.status_code)
        for k, v in r.headers.items():
            if k.lower() in ['content-length', 'content-range', 'accept-ranges']: resp.headers[k] = v
        resp.headers['Content-Type'] = mt
        resp.headers['X-Accel-Buffering'] = 'no'
        resp.headers['Content-Disposition'] = f'attachment; filename="{urllib.parse.quote(fname)}"'
        return resp
        
    elif ftype == 'swarm':
        ts = fobj.get('total') or 0
        sb, eb = get_range_bounds(ts)
        hdrs = {'Content-Type': mt, 'Accept-Ranges': 'bytes', 'Content-Disposition': f'attachment; filename="{urllib.parse.quote(fname)}"', 'X-Accel-Buffering': 'no'}
        if ts: hdrs.update({'Content-Length': str(eb - sb + 1), 'Content-Range': f'bytes {sb}-{eb}/{ts}'})
        if request.method == 'HEAD': return Response(status=206 if rh else 200, headers=hdrs)
        
        streamer = RAMSwarmStreamer(fobj['url'], ts, start_pos=sb)
        def gen_swarm():
            nonlocal sb
            try:
                c = sb
                while c <= eb:
                    with db_lock:
                        if db.get(fid, {}).get('status') == 'Stopped': break
                    d = streamer.read(min(STREAM_CHUNK_SIZE, eb - c + 1))
                    if not d: break
                    yield d
                    c += len(d)
                    with db_lock:
                        if fid in db:
                            db[fid]['down'] = c
            finally:
                streamer.close()
        return Response(gen_swarm(), status=206 if rh else 200, headers=hdrs)
        
    elif ftype == 'ram':
        headers = HEADERS.copy()
        if rh: headers['Range'] = rh
        r = creq_get(fobj['url'], headers=headers, stream=True, allow_redirects=True, timeout=(15, 86400))
        register_download_conn(fid, r)
        def gen_ram():
            try:
                for ck in r.iter_content(STREAM_CHUNK_SIZE):
                    yield ck
            finally:
                unregister_download_conn(fid, r)
                r.close()
        resp = Response(gen_ram(), status=r.status_code)
        for k, v in r.headers.items():
            if k.lower() in ['content-length', 'content-range', 'accept-ranges']: resp.headers[k] = v
        resp.headers['Content-Type'] = mt
        resp.headers['X-Accel-Buffering'] = 'no'
        resp.headers['Content-Disposition'] = f'attachment; filename="{urllib.parse.quote(fname)}"'
        return resp
        
    else:
        fp, ts = fobj.get('path'), fobj.get('total', 0)
        if not fp: return "404", 404
        sb, eb = get_range_bounds(ts)
        
        # Static Redirect if complete
        if fobj.get('status') == 'Completed' and os.path.exists(fp):
            fn = os.path.basename(fp)
            resp = Response(status=200)
            resp.headers['X-Accel-Redirect'] = f'/downloads_internal/{fn}'
            resp.headers['Content-Type'] = mt
            resp.headers['Content-Disposition'] = f'attachment; filename="{urllib.parse.quote(fname)}"'
            return resp
            
        hdrs = {'Content-Type': mt, 'Accept-Ranges': 'bytes', 'Content-Disposition': f'attachment; filename="{urllib.parse.quote(fname)}"', 'X-Accel-Buffering': 'no'}
        if ts: hdrs.update({'Content-Length': str(eb - sb + 1), 'Content-Range': f'bytes {sb}-{eb}/{ts}'})
        if request.method == 'HEAD': return Response(status=206 if rh else 200, headers=hdrs)
        
        def gen_local():
            c = sb
            end_bound = eb if ts else (2**63 - 1)
            with db_lock:
                initial_dl = db.get(fid, {}).get('down', 0) if fid in db else 0
            should_block_on_catchup = (sb < initial_dl) or (sb == 0)

            while c <= end_bound:
                with db_lock:
                    dl_pos = db.get(fid, {}).get('down', 0) if fid in db else 0
                    status = db.get(fid, {}).get('status', 'Stopped') if fid in db else 'Stopped'
                if status in ['Stopped', 'Error: Connection Refused by Host', 'Error: Incomplete'] and not os.path.exists(fp):
                    break
                if c >= dl_pos:
                    if status in ['Completed', 'Stopped', 'Error: Connection Refused by Host', 'Error: Incomplete']:
                        break
                    if should_block_on_catchup:
                        time.sleep(0.5)
                        continue
                    else:
                        break
                try:
                    with open(fp, 'rb') as lf:
                        lf.seek(c)
                        d = lf.read(min(STREAM_CHUNK_SIZE, min(end_bound - c + 1, dl_pos - c)))
                    if d:
                        yield d
                        c += len(d)
                    else:
                        time.sleep(0.5)
                except:
                    time.sleep(0.5)
        return Response(gen_local(), status=206 if rh else 200, headers=hdrs)

@app.route('/<string:a_type>_archive_dl/<string:bu>/<string:b64_name>/<path:fname>', methods=['GET', 'HEAD'])
def archive_stream(a_type, bu, b64_name, fname):
    with archive_mounts_lock:
        mount_info = archive_mounts_cache.get(bu)
    if not mount_info:
        if global_mounted_data and global_mounted_data.get('bu') == bu:
            mount_info = global_mounted_data
        else:
            return "Archive mount not found or expired.", 404
    tf = next((x for x in mount_info['files'] if x['b64'] == b64_name), None)
    if not tf: return "File not found in archive mount.", 404
    rh, ts = request.headers.get('Range'), tf['size']
    sb, eb = 0, ts - 1 if ts else 0
    if rh and ts:
        m = re.search(r'bytes=(\d+)-(\d*)', rh)
        if m: sb, eb = int(m.group(1)), int(m.group(2)) if m.group(2) else eb
        
    mt = 'application/octet-stream'
    hdrs = {'Content-Type': mt, 'Accept-Ranges': 'bytes', 'Content-Disposition': f'attachment; filename="{urllib.parse.quote(fname)}"', 'X-Accel-Buffering': 'no'}
    if ts: hdrs.update({'Content-Length': str(eb - sb + 1), 'Content-Range': f'bytes {sb}-{eb}/{ts}'})
    if request.method == 'HEAD': return Response(status=206 if rh else 200, headers=hdrs)
    def gen():
        url = base64.urlsafe_b64decode(bu.encode()).decode() if a_type != 'drive' else None
        rf = DriveRangeFile(bu, get_drive_auth()[0], 100000000) if a_type == 'drive' else HttpRangeFile(url)
        try:
            with zipfile.ZipFile(rf) as zf:
                zinfo = zf.getinfo(tf['name'])
                if zinfo.compress_type == zipfile.ZIP_STORED:
                    header_pos = zinfo.header_offset
                    rf.seek(header_pos + 26)
                    fn_len, extra_len = struct.unpack('<HH', rf.read(4))
                    data_start = header_pos + 30 + fn_len + extra_len
                    target_pos = data_start + sb
                    bytes_remaining = eb - sb + 1
                    rf.seek(target_pos)
                    while bytes_remaining > 0 and getattr(rf, 'active', True):
                        chunk_to_read = min(STREAM_CHUNK_SIZE, bytes_remaining)
                        d = rf.read(chunk_to_read)
                        if not d: break
                        yield d
                        bytes_remaining -= len(d)
                else:
                    with zf.open(zinfo) as z_item:
                        to_skip = sb
                        while to_skip > 0 and getattr(rf, 'active', True):
                            sk = min(to_skip, STREAM_CHUNK_SIZE)
                            skipped = z_item.read(sk)
                            if not skipped: break
                            to_skip -= len(skipped)
                        c = sb
                        while c <= eb and getattr(rf, 'active', True):
                            d = z_item.read(min(STREAM_CHUNK_SIZE, eb - c + 1))
                            if not d: break
                            yield d
                            c += len(d)
        except Exception as e:
            print("Engine 8 stream error:", e)
        finally:
            rf.close()
    return Response(gen(), status=206 if rh else 200, headers=hdrs)

def update_file_metadata(fid, r):
