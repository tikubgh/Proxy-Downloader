class DriveRangeFile:
    def __init__(self, file_id, access_token, size):
        self.url = f'https://www.googleapis.com/drive/v3/files/{file_id}?alt=media'
        self.headers = {'Authorization': f'Bearer {access_token}'}
        self.size = size
        self.pos = 0
        self.chunk_size = 4194304 
        self.file_id = file_id

    def _get_chunk(self, chunk_idx):
        cache_key = f"{self.file_id}_{chunk_idx}"
        with shared_drive_lock:
            if cache_key in shared_drive_cache:
                shared_drive_cache.move_to_end(cache_key)
                return shared_drive_cache[cache_key]
        start = chunk_idx * self.chunk_size
        end = min(start + self.chunk_size - 1, self.size - 1)
        if start >= self.size: return b''
        h = self.headers.copy()
        h['Range'] = f'bytes={start}-{end}'
        try:
            r = archive_session.get(self.url, headers=h, timeout=10)
            data = r.content
        except: data = b''
        with shared_drive_lock:
            shared_drive_cache[cache_key] = data
            while len(shared_drive_cache) > 128:
                shared_drive_cache.popitem(last=False)
        return data

    def read(self, size=-1):
        if self.pos >= self.size: return b''
        if size < 0 or self.pos + size > self.size: size = self.size - self.pos
        result = bytearray()
        while size > 0 and self.pos < self.size:
            chunk_idx = self.pos // self.chunk_size
            chunk_offset = self.pos % self.chunk_size
            chunk_data = self._get_chunk(chunk_idx)
            if not chunk_data: break
            take = min(size, len(chunk_data) - chunk_offset)
            result.extend(chunk_data[chunk_offset : chunk_offset + take])
            self.pos += take
            size -= take
        return bytes(result)

    def seek(self, offset, whence=0):
        if whence == 0: self.pos = offset
        elif whence == 1: self.pos += offset
        elif whence == 2: self.pos = self.size + offset
        self.pos = max(0, min(self.pos, self.size))
        return self.pos

    def tell(self): return self.pos
    def seekable(self): return True
    def readable(self): return True
    def writable(self): return False
