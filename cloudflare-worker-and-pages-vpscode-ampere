<script>
let current_stream_id = null;
const plyrPlayer = new Plyr('#plyr_video', {
    controls: ['play-large', 'play', 'progress', 'current-time', 'mute', 'volume', 'captions', 'settings', 'pip', 'airplay', 'fullscreen'],
    settings: ['captions', 'quality', 'speed']
});

function playVideo(url, name) {
    document.getElementById('video_title').innerText = '▶️ ' + decodeURIComponent(name);
    document.getElementById('video_modal').style.display = 'flex';
    
    let warnBox = document.getElementById('transcode_warning');
    warnBox.innerHTML = '⏳ Initializing Universal Apple-Compatible HLS Transcoder... (Please wait 3-5 seconds)';
    
    fetch('/api/start_hls?url=' + encodeURIComponent(url))
    .then(r => r.json())
    .then(data => {
        let playlistUrl = data.playlist_url;
        current_stream_id = data.stream_id;
        let video = document.getElementById('plyr_video');
        
        warnBox.innerHTML = '<b>✅ Universal FFmpeg HLS Pipeline Active:</b> Server is dynamically transcoding audio to AAC and strictly enforcing VOD timestamps. Perfect Apple/Windows/Android compatibility and seeking enabled!';
        
        if (Hls.isSupported()) {
            if(window.hls) window.hls.destroy();
            window.hls = new Hls({maxBufferLength: 30, maxMaxBufferLength: 60});
            window.hls.loadSource(playlistUrl);
            window.hls.attachMedia(video);
            window.hls.on(Hls.Events.MANIFEST_PARSED, function() {
                plyrPlayer.play();
            });
        } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
            video.src = playlistUrl;
            video.addEventListener('loadedmetadata', function() {
                plyrPlayer.play();
            });
        }
    }).catch(e => {
        warnBox.innerHTML = '<b>❌ Error initializing stream. Ensure target URL is active.</b>';
    });
}

function closeVideo() {
    plyrPlayer.stop();
    if(window.hls) {
        window.hls.destroy();
        window.hls = null;
    }
    document.getElementById('video_modal').style.display = 'none';
    if(current_stream_id) {
        fetch('/api/stop_hls?stream_id=' + current_stream_id);
        current_stream_id = null;
    }
}

function checkDriveStatus(){
    fetch('/api/drive/status').then(r=>r.json()).then(d=>{
        if(d.connected){
            document.getElementById('drive_dot').style.background='var(--success)';
            document.getElementById('drive_dot').style.boxShadow='0 0 8px var(--success)';
            document.getElementById('drive_auth_panel').style.display='none';
            document.getElementById('drive_connected_panel').style.display='flex';
            if(d.info) document.getElementById('drive_email').innerText = '✅ Drive Active | 💾 ' + d.info;
        } else {
            document.getElementById('drive_dot').style.background='var(--danger)';
            document.getElementById('drive_dot').style.boxShadow='0 0 8px var(--danger)';
            document.getElementById('drive_auth_panel').style.display='flex';
            document.getElementById('drive_connected_panel').style.display='none';
        }
    });
}
checkDriveStatus();
setInterval(checkDriveStatus, 60000);

function connectDrive(){
    let cid=document.getElementById('drive_cid').value;
    let csec=document.getElementById('drive_csec').value;
    let rt=document.getElementById('drive_rt').value;
    if(!cid || !csec || !rt) return alert('⚠️ All 3 keys are strictly required to build the server vault!');
    
    document.getElementById('drive_dot').style.background='var(--warn)';
    document.getElementById('drive_dot').style.boxShadow='0 0 8px var(--warn)';
    
    fetch('/api/drive/connect', {
        method: 'POST', headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({client_id: cid, client_secret: csec, refresh_token: rt})
    }).then(r=>r.json()).then(d=>{
        if(d.success) checkDriveStatus();
        else { alert('❌ ' + d.error); checkDriveStatus(); }
    });
}

function disconnectDrive(){ fetch('/api/drive/disconnect', {method:'POST'}).then(()=>checkDriveStatus()); }

