find_optimal_vpn_port() {
    python3 -c '
import socket, sys

candidates = [443, 8443, 2053, 2083, 2087, 2096, 10443, 51820, 41234, 8888, 9000, 2082, 2086, 8080, 53]

best_port = None
for p in candidates:
    try:
        # 1. Inbound TCP binding test
        s_tcp = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s_tcp.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        s_tcp.bind(("0.0.0.0", p))
        s_tcp.listen(1)
        
        # 2. Inbound UDP binding test
        s_udp = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s_udp.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        s_udp.bind(("0.0.0.0", p))
        
        # 3. Local TCP handshake test
        client_tcp = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        client_tcp.settimeout(1)
        client_tcp.connect(("127.0.0.1", p))
        conn, addr = s_tcp.accept()
        conn.close()
        client_tcp.close()
        
        # 4. Local UDP datagram transmission test
        client_udp = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        client_udp.sendto(b"PING", ("127.0.0.1", p))
        data, addr = s_udp.recvfrom(16)
        client_udp.close()
        
        s_tcp.close()
        s_udp.close()
        
        if data == b"PING":
            best_port = p
            break
    except Exception:
        continue

print(best_port if best_port else 443)
' 2>/dev/null
}

