class HttpRangeFile:
    def __init__(self, url):
        self.url = url; self.headers = HEADERS.copy()
        try:
            r = archive_session.head(url, headers=self.headers, allow_redirects=True, timeout=15)
            cl = r.headers.get('Content-Length')
            if not cl:
                r = archive_session.get(url, headers=self.headers, stream=True, allow_redirects=True, timeout=15)
                cl = r.headers.get('Content-Length', 0); self.url = r.url; r.close()
            else: self.url = r.url
            self.size = int(cl)
        except: self.size = 0
        self.pos = 0; self.chunk_size = 4194304; self.file_id = hashlib.md5(self.url.encode()).hexdigest()
    def _get_chunk(self, chunk_idx):
        ck = f"http_{self.file_id}_{chunk_idx}"
        with shared_drive_lock:
            if ck in shared_drive_cache: shared_drive_cache.move_to_end(ck); return shared_drive_cache[ck]
        start = chunk_idx * self.chunk_size; end = min(start + self.chunk_size - 1, self.size - 1)
        if start >= self.size: return b''
        h = self.headers.copy(); h['Range'] = f'bytes={start}-{end}'
        try: data = archive_session.get(self.url, headers=h, timeout=10).content
        except: data = b''
        with shared_drive_lock:
            shared_drive_cache[ck] = data
            while len(shared_drive_cache) > 128: shared_drive_cache.popitem(last=False)
        return data
    def read(self, size=-1):
        if self.pos >= self.size: return b''
        if size < 0 or self.pos + size > self.size: size = self.size - self.pos
        res = bytearray()
        while size > 0 and self.pos < self.size:
            c_idx, c_off = self.pos // self.chunk_size, self.pos % self.chunk_size
            c_data = self._get_chunk(c_idx)
            if not c_data: break
            t = min(size, len(c_data) - c_off); res.extend(c_data[c_off:c_off+t]); self.pos += t; size -= t
        return bytes(res)
    def seek(self, offset, whence=0):
        if whence == 0: self.pos = offset
        elif whence == 1: self.pos += offset
        elif whence == 2: self.pos = self.size + offset
        self.pos = max(0, min(self.pos, self.size)); return self.pos
    def tell(self): return self.pos
    def seekable(self): return True
    def readable(self): return True
    def writable(self): return False
    def close(self): pass

class SwarmRangeFile(HttpRangeFile):
    def __init__(self, url):
        super().__init__(url); self.chunk_size = 8388608; self.executor = concurrent.futures.ThreadPoolExecutor(max_workers=4)
        self.file_id = hashlib.md5(f"sw_{self.url}".encode()).hexdigest()
    def _get_chunk(self, chunk_idx):
        ck = f"sw_{self.file_id}_{chunk_idx}"
        with shared_drive_lock:
            if ck in shared_drive_cache: shared_drive_cache.move_to_end(ck); return shared_drive_cache[ck]
        start = chunk_idx * self.chunk_size; end = min(start + self.chunk_size - 1, self.size - 1)
        if start >= self.size: return b''
        part_size = 2097152
        def fetch_part(p_idx):
            p_start, p_end = start + p_idx * part_size, min(start + p_idx * part_size + part_size - 1, end)
            if p_start > end: return b''
            h = self.headers.copy(); h['Range'] = f'bytes={p_start}-{p_end}'
            for _ in range(3):
                try:
                    r = archive_session.get(self.url, headers=h, timeout=10)
                    if r.status_code in [200, 206]: return r.content
                except: time.sleep(0.5)
            return b''
        data = b''.join(list(self.executor.map(fetch_part, range(4))))
        with shared_drive_lock:
            shared_drive_cache[ck] = data
            while len(shared_drive_cache) > 64: shared_drive_cache.popitem(last=False)
        return data

