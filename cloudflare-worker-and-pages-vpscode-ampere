@app.route('/api/p2p_poll/<fid>')
def p2p_poll(fid):
    with db_lock:
        if fid not in db or db[fid]['status'] == 'Stopped': return "Stopped", 400
        ftype = db[fid]['type']
    ret = []
    now = time.time()
    
    if ftype == 'p2p':
        if fid not in p2p_streams: return "Not Found", 404
        stream = p2p_streams[fid]
        with stream.lock:
            stale = [i for i, t in stream.active.items() if now - t > 10]
            for i in stale:
                del stream.active[i]
                if i not in stream.chunks: stream.needed.add(i)
            needed_list = list(stream.needed)
            for idx in needed_list:
                if len(ret) >= 64: break
                stream.needed.remove(idx)
                stream.active[idx] = now
                ret.append(idx)
    elif ftype == 'disk_relay':
        if fid not in disk_streams: return "Not Found", 404
        stream = disk_streams[fid]
        with stream.lock:
            stale = [i for i, t in stream.active.items() if now - t > 10]
            for i in stale:
                del stream.active[i]
                if i not in stream.written_chunks: stream.prioritized.add(i)
            pri_list = sorted(list(stream.prioritized))
            for idx in pri_list:
                if len(ret) >= 64: break
                stream.prioritized.remove(idx)
                stream.active[idx] = now
                ret.append(idx)
            if len(ret) < 64:
                bg_list = sorted(list(stream.background))
                for idx in bg_list:
                    if len(ret) >= 64: break
                    stream.background.remove(idx)
                    stream.active[idx] = now
                    ret.append(idx)
    return jsonify(ret)

@app.route('/api/p2p_up/<fid>/<int:idx>', methods=['POST'])
def p2p_up(fid, idx):
    with db_lock:
        if fid not in db or db[fid]['status'] == 'Stopped': return "Stopped", 400
        ftype = db[fid]['type']
        fp = db[fid]['path']
    data = request.data
    
    if ftype == 'p2p':
        if fid not in p2p_streams: return "Not Found", 404
        stream = p2p_streams[fid]
        with stream.lock:
            stream.chunks[idx] = data
            if idx in stream.active: del stream.active[idx]
            if idx in stream.needed: stream.needed.remove(idx)
            if len(stream.chunks) > 500:
                oldest = next(iter(stream.chunks))
                del stream.chunks[oldest]
            stream.cond.notify_all()
        with db_lock: db[fid]['down'] += len(data)
    elif ftype == 'disk_relay':
        if fid not in disk_streams: return "Not Found", 404
        stream = disk_streams[fid]
        start_byte = idx * P2P_CHUNK_SIZE
        expected_len = min(P2P_CHUNK_SIZE, stream.total_size - start_byte)
        if len(data) != expected_len and stream.total_size > 0: return "Incomplete", 400
        with open(fp, 'r+b') as f:
            f.seek(start_byte)
            f.write(data)
            f.flush()
        with stream.lock:
            if idx in stream.active: del stream.active[idx]
            stream.written_chunks.add(idx)
            stream.cond.notify_all()
        with db_lock:
            db[fid]['down'] += len(data)
            if db[fid]['status'].startswith('Queued'): db[fid]['status'] = 'Uploading to Server Disk...'
        with stream.lock:
            if not stream.background and not stream.prioritized and not stream.active:
                with db_lock:
                    if db[fid]['status'] != 'Stopped': db[fid]['status'] = 'Completed'
    return "OK"

@app.route('/relay_dl/<fid>/<path:fname>', methods=['GET', 'HEAD'])
def relay_dl(fid, fname):
    with db_lock:
        if fid not in db or db[fid]['type'] not in ['p2p', 'disk_relay']: return "404", 404
        f = db[fid]
        ftype = f['type']
        ts = f.get('total', 0)
        
    last_mod = time.strftime('%a, %d %b %Y %H:%M:%S GMT', time.gmtime(f.get('start', time.time())))
    etag = f'"{fid}-{ts}"'
    mt = mimetypes.guess_type(f['name'])[0] or 'application/octet-stream'
    disp = 'inline' if mt.startswith(('video/', 'audio/')) else 'attachment'
    encoded_name = urllib.parse.quote(f["name"])
    rh = request.headers.get('Range')
    sb = 0
    eb = ts - 1 if ts > 0 else 0
    is_range = False
    
    if rh:
        m = re.search(r'bytes=(\d+)-(\d*)', rh)
        if m:
            sb = int(m.group(1))
            if m.group(2): eb = int(m.group(2))
            is_range = True
            
    hdrs = {'Accept-Ranges': 'bytes', 'ETag': etag, 'Last-Modified': last_mod, 'Cache-Control': 'no-cache, no-store, must-revalidate', 'X-Accel-Buffering': 'no', 'Access-Control-Allow-Origin': '*'}
    if request.method == 'HEAD':
        hdrs['Content-Type'] = mt
        if ts > 0: hdrs['Content-Length'] = str(ts)
        return Response(status=200, headers=hdrs)
        
    if ftype == 'p2p':
        stream = p2p_streams[fid]
        stream.connected = True
        with db_lock: db[fid]['status'] = 'Transferring (P2P)'
        
        def gen_p2p():
            curr = sb
            max_chunk = ((ts - 1) // P2P_CHUNK_SIZE) if ts > 0 else float('inf')
            while curr <= eb:
                idx = curr // P2P_CHUNK_SIZE
                offset = curr % P2P_CHUNK_SIZE
                with stream.lock:
                    for i in range(idx, min(idx + 64, max_chunk + 1)):
                        if i not in stream.chunks and i not in stream.active: stream.needed.add(i)
                    while idx not in stream.chunks:
                        with db_lock:
                            if fid not in db or db[fid]['status'] == 'Stopped': return
                        if idx not in stream.needed and idx not in stream.active: stream.needed.add(idx)
                        stream.cond.wait(timeout=0.5)
                    data = stream.chunks[idx]
                rem_in_chunk = len(data) - offset
                rem_in_req = eb - curr + 1
                take = min(rem_in_chunk, rem_in_req)
                chunk_data = data[offset:offset+take]
                for i in range(0, len(chunk_data), STREAM_CHUNK_SIZE): yield chunk_data[i:i+STREAM_CHUNK_SIZE]
                curr += take
                
        hdrs['Content-Disposition'] = f"{disp}; filename=\"{encoded_name}\"; filename*=UTF-8''{encoded_name}"
        hdrs['Content-Type'] = mt
        if ts > 0:
            l = eb - sb + 1
            hdrs['Content-Length'] = str(l)
            if is_range: hdrs['Content-Range'] = f'bytes {sb}-{eb}/{ts}'
            return Response(gen_p2p(), status=206, headers=hdrs)
        return Response(gen_p2p(), status=200, headers=hdrs)
        
    elif ftype == 'disk_relay':
        stream = disk_streams.get(fid)
        if not stream: return "Not Found", 404
        fp = f['path']
        stream.connected = True
        with db_lock:
            if db[fid]['status'] != 'Completed': db[fid]['status'] = 'Transferring (Disk Buffered)'
            
        def gen_disk():
            curr = sb
            max_chunk = ((ts - 1) // P2P_CHUNK_SIZE) if ts > 0 else float('inf')
            with open(fp, 'rb', buffering=0) as lf:
                while curr <= eb:
                    idx = curr // P2P_CHUNK_SIZE
                    with stream.lock:
                        for i in range(idx, min(idx + 64, max_chunk + 1)):
                            if i not in stream.written_chunks and i not in stream.active:
                                stream.prioritized.add(i)
                                if i in stream.background: stream.background.remove(i)
                        while idx not in stream.written_chunks:
                            with db_lock:
                                if fid not in db or db[fid]['status'] == 'Stopped': return
                            if idx not in stream.active and idx not in stream.prioritized: stream.prioritized.add(idx)
                            stream.cond.wait(timeout=0.5)
                    rem_in_chunk = P2P_CHUNK_SIZE - (curr % P2P_CHUNK_SIZE)
                    rem_in_req = eb - curr + 1
                    take_total = min(rem_in_chunk, rem_in_req)
                    lf.seek(curr)
                    bytes_yielded = 0
                    while bytes_yielded < take_total:
                        c_take = min(STREAM_CHUNK_SIZE, take_total - bytes_yielded)
                        data = lf.read(c_take)
                        if not data:
                            time.sleep(0.1)
                            continue
                        yield data
                        bytes_yielded += len(data)
                        curr += len(data)
                        
        hdrs['Content-Disposition'] = f"{disp}; filename=\"{encoded_name}\"; filename*=UTF-8''{encoded_name}"
        hdrs['Content-Type'] = mt
        if ts > 0:
            l = eb - sb + 1
            hdrs['Content-Length'] = str(l)
            if is_range: hdrs['Content-Range'] = f'bytes {sb}-{eb}/{ts}'
            return Response(gen_disk(), status=206, headers=hdrs)
        return Response(gen_disk(), status=200, headers=hdrs)

@app.route('/dl/<fid>/<path:fname>', methods=['GET', 'HEAD'])
def download(fid, fname):
    with db_lock:
        if fid not in db or not os.path.exists(db[fid]['path']): return "404", 404
        f = db[fid]
        fp = f['path']
        ts = f.get('total', 0)
        st = f['status']
        nm = f['name']
        
    mt, _ = mimetypes.guess_type(nm)
    mt = mt or 'application/octet-stream'
    disp = 'inline' if mt.startswith(('video/', 'audio/')) else 'attachment'
    
    if st == 'Completed' and ts == 0:
        ts = os.path.getsize(fp)
        with db_lock: db[fid]['total'] = ts
        
    last_mod = time.strftime('%a, %d %b %Y %H:%M:%S GMT', time.gmtime(f.get('start', time.time())))
    etag = f'"{fid}-{ts}"'
    encoded_name = urllib.parse.quote(nm)
    disp_header = f"{disp}; filename=\"{encoded_name}\"; filename*=UTF-8''{encoded_name}"
    
    if ts == 0:
        hdrs = {'Content-Type': mt, 'Content-Disposition': disp_header}
        if request.method == 'HEAD': return Response(status=200, headers=hdrs)
        def gen_unk():
            with open(fp, 'rb') as lf:
                while True:
                    c = lf.read(STREAM_CHUNK_SIZE)
                    if c: yield c
                    else:
                        with db_lock: cst = db[fid]['status']
                        if cst not in ['Completed', 'Stopped'] and 'Error' not in cst:
                            time.sleep(0.5)
                            lf.seek(lf.tell())
                        else: break
        return Response(gen_unk(), status=200, headers=hdrs)
        
    rh = request.headers.get('Range', None)
    sb = 0
    eb = ts - 1 if ts else 0
    if rh and ts:
        m = re.search(r'bytes=(\d+)-(\d*)', rh)
        if m:
            sb = int(m.group(1))
            if m.group(2): eb = int(m.group(2))
            
    l = eb - sb + 1
    hdrs = {'Content-Type': mt, 'Content-Disposition': disp_header, 'Accept-Ranges': 'bytes', 'ETag': etag, 'Last-Modified': last_mod}
    if ts: hdrs.update({'Content-Length': str(l), 'Content-Range': f'bytes {sb}-{eb}/{ts}'})
    
    if request.method == 'HEAD': return Response(status=206 if rh else 200, headers=hdrs)
    
    def gen():
        with open(fp, 'rb', buffering=0) as lf:
            curr = sb
            while curr <= eb:
                with db_lock:
                    if fid not in db: break
                    cst = db[fid]['status']
                    ftype = db[fid]['type']
                if cst in ['Completed', 'Stopped'] or 'Error' in cst:
                    lf.seek(curr)
                    c = lf.read(min(STREAM_CHUNK_SIZE, eb - curr + 1))
                    if c:
                        yield c
                        curr += len(c)
                    else: break
                    continue
                if ftype in ['multi']:
                    with db_lock:
                        chunk_size = db[fid].get('chunk_size', 2097152)
                        written = db[fid].get('written', set())
                    c_idx = curr // chunk_size
                    if c_idx in written:
                        lf.seek(curr)
                        rem_in_chunk = chunk_size - (curr % chunk_size)
                        to_read = min(STREAM_CHUNK_SIZE, eb - curr + 1, rem_in_chunk)
                        c = lf.read(to_read)
                        if c:
                            with db_lock:
                                if 'priority' not in db[fid]: db[fid]['priority'] = set()
                                max_c = ((ts - 1) // chunk_size) if ts > 0 else c_idx
                                for i in range(c_idx + 1, min(c_idx + 64, max_c + 1)):
                                    if i not in written:
                                        db[fid]['priority'].add(i)
                            yield c
                            curr += len(c)
                            continue
                        else:
                            time.sleep(0.01)
                            continue
                    else:
                        with db_lock:
                            if 'priority' not in db[fid]: db[fid]['priority'] = set()
                            max_c = ((ts - 1) // chunk_size) if ts > 0 else c_idx
                            for i in range(c_idx, min(c_idx + 64, max_c + 1)):
                                if i not in written:
                                    db[fid]['priority'].add(i)
                        time.sleep(0.05)
                else:
                    curr_size = os.path.getsize(fp)
                    if curr_size > curr:
                        lf.seek(curr)
                        c = lf.read(min(STREAM_CHUNK_SIZE, eb - curr + 1))
                        if c:
                            yield c
                            curr += len(c)
                            continue
                    time.sleep(0.5)
    return Response(gen(), status=206 if rh else 200, headers=hdrs)

