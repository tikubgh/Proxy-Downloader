@app.route('/api/p2p_poll/<fid>')
def p2p_poll(fid):
    with db_lock:
        if fid not in db or db[fid]['status'] == 'Stopped': return "Stopped", 400
        ft = db[fid]['type']
    ret, now = [], time.time()
    if ft == 'p2p' and fid in p2p_streams:
        st = p2p_streams[fid]
        with st.lock:
            for i in [i for i, t in st.active.items() if now - t > 10]: del st.active[i]; st.needed.add(i) if i not in st.chunks else None
            for idx in list(st.needed):
                if len(ret) >= 64: break
                st.needed.remove(idx); st.active[idx] = now; ret.append(idx)
    elif ft in ['disk_relay', 'folder'] and fid in disk_streams:
        st = disk_streams[fid]
        with st.lock:
            for i in [i for i, t in st.active.items() if now - t > 10]: del st.active[i]; st.prioritized.add(i) if i not in st.written_chunks else None
            for idx in sorted(list(st.prioritized)):
                if len(ret) >= 64: break
                st.prioritized.remove(idx); st.active[idx] = now; ret.append(idx)
            if len(ret) < 64:
                for idx in sorted(list(st.background)):
                    if len(ret) >= 64: break
                    st.background.remove(idx); st.active[idx] = now; ret.append(idx)
    return jsonify(ret)

@app.route('/api/p2p_up/<fid>/<int:idx>', methods=['POST'])
def p2p_up(fid, idx):
    with db_lock:
        if fid not in db or db[fid]['status'] == 'Stopped': return "Stopped", 400
        ft, fp = db[fid]['type'], db[fid]['path']
    d = request.data
    if ft == 'p2p' and fid in p2p_streams:
        st = p2p_streams[fid]
        with st.lock:
            st.chunks[idx] = d
            if idx in st.active: del st.active[idx]
            if idx in st.needed: st.needed.remove(idx)
            if len(st.chunks) > 500: del st.chunks[next(iter(st.chunks))]
            st.cond.notify_all()
        with db_lock: db[fid]['down'] += len(d)
    elif ft in ['disk_relay', 'folder'] and fid in disk_streams:
        st = disk_streams[fid]; sb = idx * P2P_CHUNK_SIZE
        if len(d) != min(P2P_CHUNK_SIZE, st.total_size - sb) and st.total_size > 0: return "Inc", 400
        with open(fp, 'r+b') as f: f.seek(sb); f.write(d); f.flush()
        with st.lock:
            if idx in st.active: del st.active[idx]
            st.written_chunks.add(idx); st.cond.notify_all()
            if not st.background and not st.prioritized and not st.active:
                with db_lock: db[fid]['status'] = 'Completed' if db[fid]['status'] != 'Stopped' else 'Stopped'
        with db_lock: db[fid]['down'] += len(d); db[fid]['status'] = 'Uploading...' if db[fid]['status'].startswith('Queued') else db[fid]['status']
    return "OK"

