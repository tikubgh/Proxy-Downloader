    if(!url) return;
    let box = document.getElementById('zip_contents');
    box.style.display = 'block';
    box.innerHTML = '<div style="color:var(--accent);">🔍 Mounting Virtual Archive to Server RAM... <br><span style="font-size:12px;color:#888;">(ZIP is instant. RAR/7z/GZ may take a few seconds to scan depending on size).</span></div>';
    
    try {
        let r = await fetch('/api/drive_archive_list?url=' + encodeURIComponent(url));
