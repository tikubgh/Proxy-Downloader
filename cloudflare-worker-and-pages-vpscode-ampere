 if ftype == 'p2p':
  stream = p2p_streams[fid]
  stream.connected = True
  with db_lock: db[fid]['status']='Transferring (P2P)'
  
  def gen_p2p():
   curr = sb
   max_chunk = ((ts - 1) // P2P_CHUNK_SIZE) if ts > 0 else float('inf')
   
   while curr <= eb:
    idx = curr // P2P_CHUNK_SIZE
    offset = curr % P2P_CHUNK_SIZE
    
    with stream.lock:
     for i in range(idx, min(idx + 16, max_chunk + 1)):
      if i not in stream.chunks and i not in stream.active:
       stream.needed.add(i)
       
     while idx not in stream.chunks:
      with db_lock:
       if fid not in db or db[fid]['status'] == 'Stopped': return
      if idx not in stream.needed and idx not in stream.active:
       stream.needed.add(idx)
      stream.cond.wait(timeout=1.0)
      
     data = stream.chunks[idx]
     
    rem_in_chunk = len(data) - offset
    rem_in_req = eb - curr + 1
    take = min(rem_in_chunk, rem_in_req)
    
    yield data[offset : offset + take]
    curr += take

  hdrs['Content-Disposition'] = f'{disp}; filename="{f["name"]}"'
  hdrs['Content-Type'] = mt
  if ts > 0:
   l = eb - sb + 1
   hdrs['Content-Length'] = str(l)
   if is_range:
    hdrs['Content-Range'] = f'bytes {sb}-{eb}/{ts}'
    return Response(gen_p2p(), status=206, headers=hdrs)
  return Response(gen_p2p(), status=200, headers=hdrs)

 elif ftype == 'disk_relay':
  stream = disk_streams.get(fid)
  if not stream: return "Not Found", 404
  fp = f['path']
  stream.connected = True
  with db_lock: db[fid]['status'] = 'Transferring (Disk Buffered)'
  
  def gen_disk():
   curr = sb
   max_chunk = ((ts - 1) // P2P_CHUNK_SIZE) if ts > 0 else float('inf')
   
   with open(fp, 'rb') as lf:
    while curr <= eb:
     idx = curr // P2P_CHUNK_SIZE
     
     with stream.lock:
      for i in range(idx, min(idx + 16, max_chunk + 1)):
       if i not in stream.written_chunks and i not in stream.active:
        stream.prioritized.add(i)
        if i in stream.background: stream.background.remove(i)
        
      while idx not in stream.written_chunks:
       with db_lock:
        if fid not in db or db[fid]['status'] == 'Stopped': return
       if idx not in stream.active and idx not in stream.prioritized: 
        stream.prioritized.add(idx)
       stream.cond.wait(timeout=1.0)
       
     rem_in_chunk = P2P_CHUNK_SIZE - (curr % P2P_CHUNK_SIZE)
     rem_in_req = eb - curr + 1
     take = min(rem_in_chunk, rem_in_req)
     
     lf.seek(curr)
     data = lf.read(take)
     if data:
      yield data
      curr += len(data)
     else: time.sleep(0.1)

  hdrs['Content-Disposition'] = f'{disp}; filename="{f["name"]}"'
  hdrs['Content-Type'] = mt
  if ts > 0:
   l = eb - sb + 1
   hdrs['Content-Length'] = str(l)
   if is_range:
    hdrs['Content-Range'] = f'bytes {sb}-{eb}/{ts}'
    return Response(gen_disk(), status=206, headers=hdrs)
  return Response(gen_disk(), status=200, headers=hdrs)

