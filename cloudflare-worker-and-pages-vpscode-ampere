            for fid in list(disk_streams.keys()):
                if fid not in db: del disk_streams[fid]
        try:
            for d in os.listdir(HLS_DIR):
                dp = os.path.join(HLS_DIR, d)
                if os.path.isdir(dp) and now - os.path.getmtime(dp) > 86400:
                    if d in hls_procs:
