        elif arch_name.endswith('.rar') and rarfile:
            with rarfile.RarFile(drf) as rf:
                for info in rf.infolist():
                    if not info.isdir():
                        b64_name = base64.urlsafe_b64encode(info.filename.encode('utf-8')).decode('utf-8')
                        safe_name = urllib.parse.quote(os.path.basename(info.filename))
                        files.append({'name': info.filename, 'size': info.file_size, 'b64': b64_name, 'url': f'/drive_archive_dl/{file_id}/{b64_name}/{safe_name}?ext=rar&sz={info.file_size}'})
                        
        elif arch_name.endswith('.7z') and py7zr:
            with py7zr.SevenZipFile(drf, mode='r') as szf:
                for info in szf.list():
                    if not info.is_directory:
                        b64_name = base64.urlsafe_b64encode(info.filename.encode('utf-8')).decode('utf-8')
                        safe_name = urllib.parse.quote(os.path.basename(info.filename))
                        files.append({'name': info.filename, 'size': info.uncompressed, 'b64': b64_name, 'url': f'/drive_archive_dl/{file_id}/{b64_name}/{safe_name}?ext=7z&sz={info.uncompressed}'})
        
        elif arch_name.endswith(('.tar.gz', '.tgz', '.tar.bz2', '.tbz2', '.tar.xz', '.txz', '.tar.lz', '.tar')):
            if arch_name.endswith('gz'): mode = 'r:gz'
            elif 'bz2' in arch_name: mode = 'r:bz2'
            elif 'xz' in arch_name or 'lz' in arch_name: mode = 'r:xz'
            else: mode = 'r:'
            
            with tarfile.open(fileobj=drf, mode=mode) as tf:
                for info in tf:
                    if info.isfile():
                        b64_name = base64.urlsafe_b64encode(info.name.encode('utf-8')).decode('utf-8')
                        safe_name = urllib.parse.quote(os.path.basename(info.name))
                        files.append({'name': info.name, 'size': info.size, 'b64': b64_name, 'url': f'/drive_archive_dl/{file_id}/{b64_name}/{safe_name}?ext={mode.replace(":", "_")}&sz={info.size}'})
        else:
            return jsonify({'error': 'Unsupported archive format. Supported: .zip, .rar, .7z, .tar, .gz, .bz2, .xz, .lz'})

        global_mounted_data = {'files': files}
        return jsonify(global_mounted_data)
    except Exception as e:
        return jsonify({'error': f'Failed to map virtual archive: {str(e)}'})

def stream_extracted_file(f, start_byte, length_to_send, fid):
    try:
        if hasattr(f, 'seek') and callable(getattr(f, 'seek', None)):
            f.seek(start_byte)
        else:
            raise Exception("No Seek")
    except Exception:
        skipped = 0
        while skipped < start_byte:
            with db_lock:
                if fid not in db or db[fid]['status'] == 'Stopped': return
            to_read = min(4194304, start_byte - skipped)
            chunk = f.read(to_read)
            if not chunk: break
            skipped += len(chunk)

    sent = 0
    while sent < length_to_send:
        with db_lock:
            if fid not in db or db[fid]['status'] == 'Stopped': break
        to_read = min(1048576, length_to_send - sent)
        chunk = f.read(to_read)
        if not chunk: break
        with db_lock: db[fid]['down'] += len(chunk)
        sent += len(chunk)
        yield chunk

@app.route('/drive_archive_dl/<file_id>/<b64_name>/<path:filename>')
def drive_archive_dl(file_id, b64_name, filename):
    try:
        ext = request.args.get('ext', 'zip')
        file_size = int(request.args.get('sz', 0))
        internal_filename = base64.urlsafe_b64decode(b64_name.encode('utf-8')).decode('utf-8')
        
        access_token, err = get_drive_auth()
        if err: return "Drive Auth Error", 500

        meta_url = f'https://www.googleapis.com/drive/v3/files/{file_id}?fields=size&supportsAllDrives=true'
        meta_res = drive_api_session.get(meta_url, headers={'Authorization': f'Bearer {access_token}'}, timeout=15).json()
        total_size = int(meta_res.get('size', 0))

        drf = DriveRangeFile(file_id, access_token, total_size)
        mt = mimetypes.guess_type(filename)[0] or 'application/octet-stream'
        
        rh = request.headers.get('Range')
        start_byte = 0
        end_byte = file_size - 1 if file_size > 0 else 0
        is_range = False

        if rh and file_size > 0:
            m = re.search(r'bytes=(\d+)-(\d*)', rh)
            if m:
                start_byte = int(m.group(1))
                if m.group(2): end_byte = int(m.group(2))
                is_range = True

        length_to_send = end_byte - start_byte + 1 if file_size > 0 else 0

        fid = hashlib.md5(f"archive_{file_id}_{b64_name}".encode()).hexdigest()[:8]
        
        with db_lock:
            if fid not in db:
                db[fid] = {
                    'id': fid, 'name': os.path.basename(internal_filename),
                    'status': 'Piping from Shared LRU RAM...', 'down': 0, 'total': file_size,
                    'type': 'archive_pipe', 'start': time.time(), 'url': ''
                }
            else:
                db[fid]['status'] = 'Piping from Shared LRU RAM...'
        
        def generate_zip():
            try:
                with zipfile.ZipFile(drf) as zf:
                    with zf.open(internal_filename) as f:
                        yield from stream_extracted_file(f, start_byte, length_to_send, fid)
            except Exception as e: pass

        def generate_rar():
            try:
                with rarfile.RarFile(drf) as rf:
                    with rf.open(internal_filename) as f:
                        yield from stream_extracted_file(f, start_byte, length_to_send, fid)
            except Exception as e: pass
                    
        def generate_7z():
            try:
                with py7zr.SevenZipFile(drf, mode='r') as szf:
                    f = szf.read([internal_filename])[internal_filename]
                    yield from stream_extracted_file(f, start_byte, length_to_send, fid)
            except Exception as e: pass

        def generate_tar():
            try:
                mode = ext.replace('_', ':')
                with tarfile.open(fileobj=drf, mode=mode) as tf:
                    f = tf.extractfile(internal_filename)
                    if not f: return
                    yield from stream_extracted_file(f, start_byte, length_to_send, fid)
            except Exception as e: pass

        encoded_name = urllib.parse.quote(os.path.basename(internal_filename))
        hdrs = {
            'Content-Type': mt,
            'Content-Disposition': f"attachment; filename*=UTF-8''{encoded_name}",
            'Accept-Ranges': 'bytes',
            'Cache-Control': 'no-store',
            'Access-Control-Allow-Origin': '*'
        }
        
        if file_size > 0:
            hdrs['Content-Length'] = str(length_to_send)
            if is_range:
                hdrs['Content-Range'] = f'bytes {start_byte}-{end_byte}/{file_size}'

        if ext == 'zip': return Response(generate_zip(), status=206 if is_range else 200, headers=hdrs)
        elif ext == 'rar': return Response(generate_rar(), status=206 if is_range else 200, headers=hdrs)
        elif ext == '7z': return Response(generate_7z(), status=206 if is_range else 200, headers=hdrs)
        else: return Response(generate_tar(), status=206 if is_range else 200, headers=hdrs)

    except Exception as e: return str(e), 500

