                                if any(x in str(e) for x in ["Rate Limit", "429", "503", "508", "Too Many Requests"]):
                                    if not ll: sc, ll, ss, let = max(2, aw - 2), True, False, time.time(); ma = min(ma, sc)
                        finally:
                            if not suc:
