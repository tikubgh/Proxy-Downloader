echo "   Link: http://$IP:8080"
echo "   User: admin"
echo "--------------------------------------------"
echo "🌐 2. YOUR BROWSER (Ultraviolet)"
echo "   Link: https://$IP:8443"
echo "   Note: Click 'Advanced -> Proceed' for SSL"
echo "============================================"
EOF
