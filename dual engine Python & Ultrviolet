rm -f setup.sh
cat > setup.sh << 'EOF'
#!/bin/bash
clear

echo "============================================"
echo "🔐 Dual-Engine Security Setup"
echo "============================================"
echo -n "Create a password for your Port 8080 Downloader (username will be 'admin'): "
read -s PROXY_PASS
echo ""
if [ -z "$PROXY_PASS" ]; then
    PROXY_PASS="admin123"
    echo "⚠️ No password entered. Defaulting to: admin123"
else
    echo "✅ Password saved securely."
fi
echo "============================================"
sleep 1

echo "🛑 Cleaning up and separating network ports..."
if command -v pm2 &> /dev/null; then pm2 delete all >/dev/null 2>&1; fi
sudo systemctl stop nginx proxy >/dev/null 2>&1
killall node python python3 >/dev/null 2>&1
fuser -k 8080/tcp >/dev/null 2>&1
fuser -k 8081/tcp >/dev/null 2>&1
fuser -k 8443/tcp >/dev/null 2>&1
sleep 2

echo "📦 Installing Core Dependencies..."
apt update -y -qq >/dev/null 2>&1
apt install -y python3-venv python3-pip python3-psutil ufw nginx git >/dev/null 2>&1

echo "🛡️ Configuring Dual Firewalls..."
ufw allow 8080/tcp >/dev/null 2>&1
ufw allow 8443/tcp >/dev/null 2>&1
ufw --force enable >/dev/null 2>&1

# ==========================================
# ENGINE 1: THE PYTHON DOWNLOADER (PORT 8080)
# ==========================================
echo "🐍 Building Engine 1: Secure Python Downloader..."
python3 -m venv /root/venv
/root/venv/bin/pip install flask requests psutil >/dev/null 2>&1

cat > /root/proxy.py << 'PYTHON'
from flask import Flask, request, Response, jsonify, render_template_string
import requests, os, re, psutil, time

app = Flask(__name__)
PROXY_PASS = os.environ.get('PROXY_PASS', 'admin123')

@app.before_request
def require_auth():
    auth = request.authorization
    if not auth or auth.username != 'admin' or auth.password != PROXY_PASS:
        return Response('Proxy Authentication Required', 401, {'WWW-Authenticate': 'Basic realm="Secure Proxy"'})

HTML='''<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>VPS Downloader</title><style>body{background:#121212;color:#eee;font-family:sans-serif;padding:20px;max-width:600px;margin:auto}input,button{padding:12px;margin:5px 0;width:100%;box-sizing:border-box;background:#222;color:#eee;border:1px solid #444;border-radius:4px;font-size:16px}button{background:#007bff;border:none;cursor:pointer;font-weight:bold}button:hover{background:#0056b3}.m{margin-top:20px;background:#1a1a1a;padding:20px;border-radius:8px;border:1px solid #333;line-height:1.6}h2,h3{margin-top:0;color:#fff}</style></head><body><h2>🚀 Direct Downloader</h2><form action="/download" method="GET"><input name="url" placeholder="Paste direct file URL here..." required><button type="submit">Download via VPS</button></form><div class="m"><h3>📊 Live VPS Monitor</h3><div id="cpu">CPU: Loading...</div><div id="ram">RAM: Loading...</div><div id="disk">Disk: Loading...</div><div id="net">Net: Loading...</div><div id="total" style="font-size:0.9em;color:#aaa;margin-top:10px;border-top:1px solid #333;padding-top:10px">Total: Loading...</div></div><script>setInterval(()=>fetch('/status').then(r=>r.json()).then(d=>{document.getElementById('cpu').innerText='CPU: '+d.cpu+'%';document.getElementById('ram').innerText='RAM: '+d.ram+'%';document.getElementById('disk').innerText='Disk: '+d.disk+'%';document.getElementById('net').innerText='Network: '+d.net;document.getElementById('total').innerText=d.total;}).catch(e=>console.log("Monitor offline")), 1000)</script></body></html>'''

p, pt = psutil.net_io_counters(), time.time()

def bw():
    global p, pt; n, t = psutil.net_io_counters(), time.time(); d = t - pt or 1
    s = (n.bytes_sent - p.bytes_sent) / d; r = (n.bytes_recv - p.bytes_recv) / d
    p, pt = n, t
    f = lambda b: f"{b/1024:.2f} KB/s" if b < 1024*1024 else f"{b/(1024*1024):.2f} MB/s"
    return f"↑ {f(s)}  |  ↓ {f(r)}"

def total():
    n = psutil.net_io_counters()
    f = lambda b: f"{b/(1024*1024):.2f} MB" if b < 1024*1024*1024 else f"{b/(1024*1024*1024):.2f} GB"
    return f"Uploaded: {f(n.bytes_sent)} | Downloaded: {f(n.bytes_recv)}"

def filename(r, u):
    cd = r.headers.get('Content-Disposition')
    if cd:
        m = re.search(r'filename="?(.*?)"?(;|$)', cd)
        if m: return m.group(1)
    name = os.path.basename(u.split('?')[0])
    return name if name else 'proxied_file'

@app.route('/')
def index(): return render_template_string(HTML)

@app.route('/download')
def download():
    u = request.args.get('url')
    if not u: return "Missing URL", 400
    h = {'Range': request.headers.get('Range')} if request.headers.get('Range') else {}
    try:
        r = requests.get(u, stream=True, headers=h, timeout=15)
        resp_h = {'Content-Disposition': f'attachment; filename="{filename(r, u)}"', 'Content-Type': r.headers.get('Content-Type', 'application/octet-stream')}
        for head in ['Content-Length', 'Content-Range', 'Accept-Ranges']:
            if head in r.headers: resp_h[head] = r.headers[head]
        return Response(r.iter_content(chunk_size=8192), status=r.status_code, headers=resp_h)
    except Exception as e:
        return f"Error: {str(e)}", 500

@app.route('/status')
def status(): return jsonify({'cpu': psutil.cpu_percent(), 'ram': psutil.virtual_memory().percent, 'disk': psutil.disk_usage('/').percent, 'net': bw(), 'total': total()})

if __name__ == '__main__': app.run(host='0.0.0.0', port=8080)
PYTHON

cat > /etc/systemd/system/proxy.service << SERVICE_EOF
[Unit]
Description=Secure Python Proxy
After=network.target

[Service]
Environment="PROXY_PASS=${PROXY_PASS}"
ExecStart=/root/venv/bin/python /root/proxy.py
Restart=always
User=root

[Install]
WantedBy=multi-user.target
SERVICE_EOF

systemctl daemon-reload
systemctl enable proxy >/dev/null 2>&1
systemctl restart proxy


# ==========================================
# ENGINE 2: ULTRAVIOLET BROWSER (PORT 8443)
# ==========================================
echo "🌐 Building Engine 2: Fast Ultraviolet Browser..."
rm -rf /home/ubuntu/Ultraviolet-App
cd /home/ubuntu
git clone https://github.com/titaniumnetwork-dev/Ultraviolet-App.git >/dev/null 2>&1
cd Ultraviolet-App

echo "🔨 Installing UV Dependencies..."
npm install --silent >/dev/null 2>&1

# THE PORT SHIFT: Force UV to run on 8081 so it doesn't destroy the Python app on 8080
sed -i '1s/^/process.env.PORT = 8081;\n/' src/index.js

echo "⚙️ Building UV Engine..."
npm run build --silent >/dev/null 2>&1

echo "🔐 Generating SSL Certificate for UV..."
openssl req -nodes -new -x509 -keyout server.key -out server.cert -days 365 -subj "/C=IN/ST=State/L=City/O=Organization/OU=Department/CN=localhost" >/dev/null 2>&1

echo "⚡ Configuring Nginx to bridge UV..."
cat << 'NGINX' | sudo tee /etc/nginx/sites-available/ultraviolet >/dev/null
server {
    listen 8443 ssl;
    ssl_certificate /home/ubuntu/Ultraviolet-App/server.cert;
    ssl_certificate_key /home/ubuntu/Ultraviolet-App/server.key;

    location / {
        proxy_pass http://127.0.0.1:8081; # Pointing to the shifted port
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
NGINX

sudo ln -sf /etc/nginx/sites-available/ultraviolet /etc/nginx/sites-enabled/
sudo rm -f /etc/nginx/sites-enabled/default
sudo systemctl restart nginx

echo "🚀 Starting UV Engine..."
pm2 start src/index.js --name "ultraviolet" >/dev/null 2>&1

IP=$(curl -s ifconfig.me)
