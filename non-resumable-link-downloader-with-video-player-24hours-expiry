@app.route('/api/add')
def add():
    u = request.args.get('url')
    t = request.args.get('type', 'disk')
    if not u: return "Err", 400
    fid = str(uuid.uuid4())[:8]
    name = os.path.basename(u.split('?')[0]) or f"file_{fid}.mp4"
    
    with db_lock:
        db[fid] = {'id': fid, 'url': str(u), 'name': name, 'path': '', 'down': 0, 'total': 0, 'status': 'Starting...', 'start': time.time(), 'type': t}
    
    if t == 'disk':
        threading.Thread(target=dl_worker, args=(fid,)).start()
    else:
        try:
            r = requests.head(u, timeout=5)
            with db_lock:
                db[fid]['total'] = int(r.headers.get('content-length', 0))
                db[fid]['status'] = 'Proxy Active'
                cd = r.headers.get('content-disposition')
                if cd and 'filename=' in cd:
                    db[fid]['name'] = cd.split('filename=')[-1].strip('"\'')
        except: pass

    return "OK"

@app.route('/api/action/<fid>/<act>')
