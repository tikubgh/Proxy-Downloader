    audio_track = request.args.get('audio', '0')

    def generate():
        cmd = [
            'nice', '-n', '19',
            'ffmpeg', '-probesize', '50M', '-analyzeduration', '50M',
            '-i', url,
            '-map', '0:v:0?', '-map', f'0:a:{audio_track}?',
            '-c:v', 'copy',
            '-c:a', 'aac', '-b:a', '192k', '-ac', '2',
            '-threads', '2',
            '-movflags', 'frag_keyframe+empty_moov',
            '-f', 'mp4',
            'pipe:1'
        ]
        process = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        active_procs[fid] = process
        
        try:
            while True:
                chunk = process.stdout.read(CHUNK_SIZE)
                if not chunk: break
                yield chunk
        except GeneratorExit:
            # DISCONNECT CATCHER: Kills FFmpeg the exact millisecond you close the player
            try: process.kill()
            except: pass
        finally:
            try: process.kill()
            except: pass
            if fid in active_procs: del active_procs[fid]

    headers = {'Content-Type': 'video/mp4', 'Cache-Control': 'no-cache'}
    return Response(generate(), mimetype='video/mp4', headers=headers)

