def web_forge_worker(fid):
    with db_lock:
        if fid not in db: return
        f = db[fid]
        old_path = f['path']
        old_name = f['name']
    with db_lock: db[fid]['status'] = 'Forging (Fixing Audio & Timeline Maps)...'
    new_name = old_name.rsplit('.', 1)[0] + "_WebReady.mp4"
    new_path = os.path.join(DL_DIR, f"{fid}_{new_name}")
    cmd = ['nice', '-n', '19', 'ffmpeg', '-y', '-i', old_path, '-c:v', 'copy', '-c:a', 'aac', '-b:a', '256k', '-ac', '2', '-movflags', '+faststart', new_path]
    try:
        process = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        active_procs[fid] = process
        process.wait()
        with db_lock:
            if db[fid]['status'] != 'Stopped':
                os.remove(old_path)
                db[fid]['name'] = new_name
                db[fid]['path'] = new_path
                db[fid]['status'] = 'Completed'
    except:
