def multi_worker(fid):
    with db_lock:
        if fid not in db: return
        f = db[fid]
        url = f['url']
    try:
        try:
            r_ping = requests.head(url, headers=HEADERS, allow_redirects=True, timeout=10)
            if r_ping.status_code >= 400 or not r_ping.headers.get('content-length'):
                r_ping = requests.get(url, headers=HEADERS, stream=True, timeout=10)
        except:
            r_ping = requests.get(url, headers=HEADERS, stream=True, timeout=10)

        total_size = int(r_ping.headers.get('content-length', 0))
        if total_size == 0:
            with db_lock: db[fid]['status'] = 'Error: Source denies multi-threading.'
            return

        fname = f"video_{fid}.mp4"
        cd = r_ping.headers.get('content-disposition')
        if cd and 'filename=' in cd:
            extracted = cd.split('filename=')[-1].strip('"\'')
            if extracted: fname = extracted
        else:
            base = os.path.basename(urllib.parse.urlparse(url).path)
            if base: fname = base
        if hasattr(r_ping, 'close'): r_ping.close()
        
        fpath = os.path.join(DL_DIR, f"{fid}_{fname}")

        with db_lock:
            db[fid]['total'] = total_size
            db[fid]['name'] = fname
            db[fid]['path'] = fpath
            db[fid]['status'] = 'Downloading (16x Sequential Swarm)'

        with open(fpath, 'wb') as f:
            f.truncate(total_size)

        q = queue.PriorityQueue()
        end_chunk_size = 5242880 
        last_chunk_start = max(0, total_size - end_chunk_size)
        q.put((0, last_chunk_start, total_size - 1))

        micro_chunk = 10485760 
        priority_index = 1
        for i in range(0, last_chunk_start, micro_chunk):
            end = min(i + micro_chunk - 1, last_chunk_start - 1)
            q.put((priority_index, i, end))
            priority_index += 1

        stop_event = threading.Event()
        active_procs[fid] = stop_event

        def worker():
            while not q.empty() and not stop_event.is_set():
                try: priority, start, end = q.get_nowait()
                except queue.Empty: break
                success = False
                retries = 10 
                chunk_length = end - start + 1
                while not success and retries > 0 and not stop_event.is_set():
                    try:
                        thread_headers = HEADERS.copy()
                        thread_headers['Range'] = f'bytes={start}-{end}'
                        with requests.get(url, headers=thread_headers, stream=True, timeout=10) as r:
                            if r.status_code == 429:
                                time.sleep(3)
                                continue
                            r.raise_for_status()
                            with open(fpath, 'r+b') as f:
                                f.seek(start)
                                for chunk in r.iter_content(chunk_size=1048576):
                                    if stop_event.is_set(): return
                                    if chunk: f.write(chunk)
                        success = True
                    except Exception:
                        retries -= 1
                        time.sleep(2)
                if success:
                    with db_lock: db[fid]['down'] += chunk_length
                else:
                    q.put((priority, start, end))
                    time.sleep(3)

        threads_list = []
        for _ in range(16):
            t = threading.Thread(target=worker)
            t.start()
            threads_list.append(t)
            time.sleep(0.5) 

        while any(t.is_alive() for t in threads_list):
            if stop_event.is_set(): break
            time.sleep(0.5)

        if not stop_event.is_set():
            with db_lock:
                db[fid]['down'] = total_size
                db[fid]['status'] = 'Completed'
        else:
            with db_lock:
                if db[fid]['status'] != 'Stopped': db[fid]['status'] = 'Error: CDN Hard Block'
    except Exception as e:
        with db_lock: db[fid]['status'] = f'Error: Connection Blocked'

