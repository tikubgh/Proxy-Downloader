            # THE ASSASSIN: Kills the FFmpeg process immediately
            if fid in active_procs:
                try: 
                    active_procs[fid].kill()
                    del active_procs[fid]
                except: pass
                
            if db[fid]['type'] == 'disk':
                try: os.remove(db[fid]['path'])
                except: pass
            del db[fid]
        elif act == 'forge' and db[fid]['type'] == 'disk':
            threading.Thread(target=web_forge_worker, args=(fid,)).start()
    return "OK"

