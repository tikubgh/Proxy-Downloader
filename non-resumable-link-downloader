def dl_worker(fid):
    f = db[fid]
    try:
        r = requests.get(f['url'], stream=True, timeout=15)
        f['total'] = int(r.headers.get('content-length', 0))
        f['status'] = 'Downloading'
        
        cd = r.headers.get('content-disposition')
        if cd:
            m = re.search(r'filename="?(.*?)"?(;|$)', cd)
            if m: 
                f['name'] = m.group(1)
                new_path = os.path.join(DL_DIR, f"{fid}_{f['name']}")
                f['path'] = new_path

        with open(f['path'], 'wb') as out:
            for chunk in r.iter_content(65536):
                if f['status'] == 'Stopped': break
                if chunk:
                    out.write(chunk)
                    f['down'] += len(chunk)
        
        if f['status'] != 'Stopped':
            f['status'] = 'Completed'
    except Exception as e:
        f['status'] = f'Error: {str(e)[:20]}'

p, pt = psutil.net_io_counters(), time.time()
def bw():
    global p, pt; n, t = psutil.net_io_counters(), time.time(); d = t - pt or 1
    s = (n.bytes_sent - p.bytes_sent) / d; r = (n.bytes_recv - p.bytes_recv) / d
    p, pt = n, t
    f = lambda b: f"{b/1024:.2f} KB/s" if b < 1024*1024 else f"{b/(1024*1024):.2f} MB/s"
    return f"↑ {f(s)} | ↓ {f(r)}"

@app.route('/')
def index(): return render_template_string(HTML)

@app.route('/add')
def add():
    u = request.args.get('url')
    if not u: return "Err", 400
    fid = str(uuid.uuid4())[:8]
    name = os.path.basename(u.split('?')[0]) or f"file_{fid}"
    db[fid] = {'id': fid, 'url': u, 'name': name, 'path': os.path.join(DL_DIR, f"{fid}_{name}"), 'down': 0, 'total': 0, 'status': 'Starting...', 'start': time.time()}
    threading.Thread(target=dl_worker, args=(fid,)).start()
    return "OK"

@app.route('/action/<fid>/<act>')
def action(fid, act):
    if fid in db and act == 'stop':
        db[fid]['status'] = 'Stopped'
        try: os.remove(db[fid]['path'])
        except: pass
        del db[fid]
    return "OK"

# ==========================================
# ADVANCED TAILING DOWNLOAD ROUTE
# ==========================================
@app.route('/dl/<fid>')
def download(fid):
    if fid not in db or not os.path.exists(db[fid]['path']): 
        return "File not found or deleted.", 404
        
    f = db[fid]
    file_path = f['path']
    file_name = f['name']
    total_size = f.get('total', 0)
    
    # If the file is 100% finished on the VPS, use standard high-speed send_file
    if f['status'] == 'Completed':
        return send_file(file_path, as_attachment=True, download_name=file_name, conditional=True)

    # If the file is actively downloading, spoof the headers so IDM sees the final size
    range_header = request.headers.get('Range', None)
    start_byte = 0
    end_byte = total_size - 1 if total_size else 0

    if range_header and total_size:
        match = re.search(r'bytes=(\d+)-(\d*)', range_header)
        if match:
            start_byte = int(match.group(1))
            if match.group(2):
                end_byte = int(match.group(2))

    length = end_byte - start_byte + 1

    def generate():
        with open(file_path, 'rb') as local_file:
            local_file.seek(start_byte)
            bytes_sent = 0
            
            while bytes_sent < length:
                chunk = local_file.read(65536)
                if chunk:
                    yield chunk
                    bytes_sent += len(chunk)
                else:
                    # We hit the end of the physical disk file, but it's not finished yet!
                    if db[fid]['status'] in ['Downloading', 'Starting...']:
                        time.sleep(0.5) # Wait half a second for the VPS to write more data
                        local_file.seek(start_byte + bytes_sent) # Re-orient the reader
                    else:
                        break # The file finished or errored out

    headers = {
        'Content-Type': 'application/octet-stream',
        'Content-Disposition': f'attachment; filename="{file_name}"',
        'Accept-Ranges': 'bytes'
    }
    
    # Inject the true total file size
    if total_size:
        headers['Content-Length'] = str(length)
        headers['Content-Range'] = f'bytes {start_byte}-{end_byte}/{total_size}'

    status_code = 206 if range_header else 200
    return Response(generate(), status=status_code, headers=headers)

@app.route('/api/data')
def api_data():
    return jsonify({
        'sys': {'cpu': psutil.cpu_percent(), 'ram': psutil.virtual_memory().percent, 'disk': psutil.disk_usage('/').percent, 'net': bw()},
        'files': db
    })

if __name__ == '__main__': app.run(host='0.0.0.0', port=8080)
