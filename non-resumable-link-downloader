def dl_worker(fid):
    with db_lock:
        if fid not in db: return
        f = db[fid]
    try:
        r = requests.get(f['url'], stream=True, timeout=15)
        f['total'] = int(r.headers.get('content-length', 0))
        f['status'] = 'Downloading'
        
        cd = r.headers.get('content-disposition')
        if cd:
            m = re.search(r'filename="?(.*?)"?(;|$)', cd)
            if m: 
                f['name'] = m.group(1)
                f['path'] = os.path.join(DL_DIR, f"{fid}_{f['name']}")

        with open(f['path'], 'wb') as out:
            for chunk in r.iter_content(65536):
                with db_lock:
                    if db[fid]['status'] == 'Stopped': break
                if chunk:
                    out.write(chunk)
                    with db_lock: db[fid]['down'] += len(chunk)
        
        with db_lock:
            if db[fid]['status'] != 'Stopped': db[fid]['status'] = 'Completed'
    except Exception as e:
        with db_lock: db[fid]['status'] = 'Error: Link Failed'

# CRITICAL: Crash-Proof Bandwidth Monitor
p = None
pt = time.time()
try: p = psutil.net_io_counters()
except: pass

def bw():
    global p, pt
    try:
        n = psutil.net_io_counters()
        if not n or not p: return "N/A"
        t = time.time()
        d = t - pt or 1
        s = (n.bytes_sent - p.bytes_sent) / d
        r = (n.bytes_recv - p.bytes_recv) / d
        p, pt = n, t
        f = lambda b: f"{b/1024:.2f} KB/s" if b < 1024*1024 else f"{b/(1024*1024):.2f} MB/s"
        return f"↑ {f(s)} | ↓ {f(r)}"
    except: return "N/A"

@app.route('/')
