@app.route('/api/data')
def api_data():
    safe_files = []
    with db_lock:
        for fid, f in db.items():
            safe_files.append({
                'id': str(fid), 'name': str(f.get('name', 'Unknown')),
                'status': str(f.get('status', 'Pending')),
                'down': int(f.get('down', 0)), 'total': int(f.get('total', 0))
            })
    return jsonify({"sys": sys_data, "files": safe_files})

@app.route('/api/add')
def add():
    u = request.args.get('url')
    if not u: return "Err", 400
    fid = str(uuid.uuid4())[:8]
    with db_lock:
        db[fid] = {'id': fid, 'url': str(u), 'name': 'Fetching...', 'path': '', 'down': 0, 'total': 0, 'status': 'Starting...', 'start': time.time()}
    threading.Thread(target=dl_worker, args=(fid,)).start()
    return "OK"

@app.route('/api/action/<fid>/<act>')
def action(fid, act):
    with db_lock:
        if fid not in db: return "OK"
        if act == 'stop':
            db[fid]['status'] = 'Stopped'
            try: os.remove(db[fid]['path'])
            except: pass
            del db[fid]
        elif act == 'forge':
            threading.Thread(target=web_forge_worker, args=(fid,)).start()
    return "OK"

@app.route('/stream/<fid>')
def stream(fid):
    with db_lock:
        if fid not in db or not os.path.exists(db[fid]['path']): return "404", 404
        fpath = db[fid]['path']
    return send_file(fpath, conditional=True)

@app.route('/stream_live/<fid>')
def stream_live(fid):
    with db_lock:
        if fid not in db or not os.path.exists(db[fid]['path']): return "404", 404
        fpath = db[fid]['path']

    while os.path.getsize(fpath) < 2000000:
        with db_lock:
            if db[fid]['status'] == 'Stopped': return "404", 404
        time.sleep(0.5)

    def generate():
        cmd = [
            'nice', '-n', '15',
            'cpulimit', '-l', '90', '--',
            'ffmpeg', '-i', fpath,
            '-c:v', 'copy',
            '-c:a', 'aac', '-b:a', '192k', '-ac', '2',
            '-threads', '1',
            '-movflags', 'frag_keyframe+empty_moov',
            '-f', 'mp4',
            'pipe:1'
        ]
        process = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        try:
            while True:
                chunk = process.stdout.read(65536)
                if not chunk: break
                yield chunk
        finally:
            process.terminate()

    headers = {'Content-Type': 'video/mp4', 'Cache-Control': 'no-cache'}
    return Response(generate(), mimetype='video/mp4', headers=headers)

# ==========================================
# IDM SPOOFER WITH FILENAME PARSING
# ==========================================
# CRITICAL FIX: The <path:filename> forces IDM to parse the actual filename from the URL string
@app.route('/dl/<fid>/<path:filename>')
def download(fid, filename):
    with db_lock:
        if fid not in db or not os.path.exists(db[fid]['path']): return "404", 404
        f = db[fid]
        fpath = f['path']
        fname = f['name']
        total_size = f.get('total', 0)
        status = f['status']
        
    if status == 'Completed':
        return send_file(fpath, as_attachment=True, download_name=fname, conditional=True)

    range_header = request.headers.get('Range', None)
    start_byte = 0
    end_byte = total_size - 1 if total_size else 0

    if range_header and total_size:
        match = re.search(r'bytes=(\d+)-(\d*)', range_header)
        if match:
            start_byte = int(match.group(1))
            if match.group(2): end_byte = int(match.group(2))

    length = end_byte - start_byte + 1

    def generate():
        with open(fpath, 'rb') as local_file:
            local_file.seek(start_byte)
            bytes_sent = 0
            while bytes_sent < length:
                chunk = local_file.read(65536)
                if chunk:
                    yield chunk
                    bytes_sent += len(chunk)
                else:
                    with db_lock: curr_status = db[fid]['status']
                    if curr_status in ['Downloading', 'Starting...']:
                        time.sleep(0.5)
                        local_file.seek(start_byte + bytes_sent)
                    else: break

    headers = {
        'Content-Type': 'application/octet-stream',
        'Content-Disposition': f'attachment; filename="{fname}"',
        'Accept-Ranges': 'bytes'
    }
    
    if total_size:
        headers['Content-Length'] = str(length)
        headers['Content-Range'] = f'bytes {start_byte}-{end_byte}/{total_size}'

    status_code = 206 if range_header else 200
    return Response(generate(), status=status_code, headers=headers)

