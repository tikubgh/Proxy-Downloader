@app.route('/add')
def add():
    u = request.args.get('url')
    if not u: return "Err", 400
    fid = str(uuid.uuid4())[:8]
    name = os.path.basename(u.split('?')[0]) or f"file_{fid}"
    with db_lock:
        db[fid] = {'id': fid, 'url': u, 'name': name, 'path': os.path.join(DL_DIR, f"{fid}_{name}"), 'down': 0, 'total': 0, 'status': 'Starting...', 'start': time.time()}
    threading.Thread(target=dl_worker, args=(fid,)).start()
    return "OK"

@app.route('/action/<fid>/<act>')
def action(fid, act):
    with db_lock:
        if fid in db and act == 'stop':
            db[fid]['status'] = 'Stopped'
            try: os.remove(db[fid]['path'])
            except: pass
            del db[fid]
    return "OK"

@app.route('/dl/<fid>')
def download(fid):
    with db_lock:
        if fid not in db or not os.path.exists(db[fid]['path']): 
            return "File not found or deleted.", 404
        f = db[fid]
        file_path = f['path']
        file_name = f['name']
        total_size = f.get('total', 0)
        status = f['status']
    
    if status == 'Completed':
        return send_file(file_path, as_attachment=True, download_name=file_name, conditional=True)

    range_header = request.headers.get('Range', None)
    start_byte = 0
    end_byte = total_size - 1 if total_size else 0

    if range_header and total_size:
        match = re.search(r'bytes=(\d+)-(\d*)', range_header)
        if match:
            start_byte = int(match.group(1))
            if match.group(2):
                end_byte = int(match.group(2))

    length = end_byte - start_byte + 1

    def generate():
        with open(file_path, 'rb') as local_file:
            local_file.seek(start_byte)
            bytes_sent = 0
            while bytes_sent < length:
                chunk = local_file.read(65536)
                if chunk:
                    yield chunk
                    bytes_sent += len(chunk)
                else:
                    with db_lock: curr_status = db[fid]['status']
                    if curr_status in ['Downloading', 'Starting...']:
                        time.sleep(0.5)
                        local_file.seek(start_byte + bytes_sent)
                    else: break

    headers = {
        'Content-Type': 'application/octet-stream',
        'Content-Disposition': f'attachment; filename="{file_name}"',
        'Accept-Ranges': 'bytes'
    }
    
    if total_size:
        headers['Content-Length'] = str(length)
        headers['Content-Range'] = f'bytes {start_byte}-{end_byte}/{total_size}'

    status_code = 206 if range_header else 200
    return Response(generate(), status=status_code, headers=headers)

@app.route('/api/data')
def api_data():
    # CRITICAL: Safe hardware polling that will never crash the JSON
    sys_data = {'cpu': 'N/A', 'ram': 'N/A', 'disk': 'N/A', 'net': bw()}
    try: sys_data['cpu'] = psutil.cpu_percent()
    except: pass
    try: sys_data['ram'] = psutil.virtual_memory().percent
    except: pass
    try: sys_data['disk'] = psutil.disk_usage('/').percent
    except: pass

    # Safe dictionary copy prevents "changed size during iteration" crash
    with db_lock:
        safe_files = {k: v.copy() for k, v in db.items()}

    return jsonify({'sys': sys_data, 'files': safe_files})

if __name__ == '__main__': 
