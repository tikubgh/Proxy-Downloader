if command -v pm2 &> /dev/null; then pm2 delete all >/dev/null 2>&1; fi
sudo systemctl stop nginx proxy >/dev/null 2>&1
killall node python python3 google-chrome Xvfb x11vnc websockify >/dev/null 2>&1
