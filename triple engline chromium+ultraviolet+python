cat << 'NGINX' | sudo tee /etc/nginx/sites-available/ultraviolet >/dev/null
server {
    listen 8443 ssl;
    ssl_certificate /home/ubuntu/Ultraviolet-App/server.cert;
    ssl_certificate_key /home/ubuntu/Ultraviolet-App/server.key;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
NGINX

sudo ln -sf /etc/nginx/sites-available/ultraviolet /etc/nginx/sites-enabled/
