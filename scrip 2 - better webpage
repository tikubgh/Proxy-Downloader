rm -f setup.sh
cat > setup.sh << 'EOF'
#!/bin/bash
clear

echo "🛑 Purging Ultraviolet and freeing Port 8080..."
if command -v pm2 &> /dev/null; then pm2 delete all >/dev/null 2>&1; fi
killall node >/dev/null 2>&1
sudo systemctl stop nginx >/dev/null 2>&1
fuser -k 8080/tcp >/dev/null 2>&1
sleep 2

echo "📦 Installing Dependencies..."
apt update -y -qq && apt install -y python3-venv python3-pip python3-psutil ufw >/dev/null 2>&1

echo "🛡️ Configuring Firewall..."
ufw allow 8080/tcp >/dev/null 2>&1
ufw --force enable >/dev/null 2>&1

echo "🐍 Setting up Python Environment..."
python3 -m venv /root/venv
/root/venv/bin/pip install flask requests psutil >/dev/null 2>&1

echo "⚙️ Writing Fixed Proxy Application..."
cat > /root/proxy.py << 'PYTHON'
from flask import Flask, request, Response, jsonify, render_template_string
import requests, os, re, psutil, time

app = Flask(__name__)

HTML='''<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>VPS Proxy</title><style>body{background:#121212;color:#eee;font-family:sans-serif;padding:20px;max-width:600px;margin:auto}input,button{padding:12px;margin:5px 0;width:100%;box-sizing:border-box;background:#222;color:#eee;border:1px solid #444;border-radius:4px;font-size:16px}button{background:#007bff;border:none;cursor:pointer;font-weight:bold}button:hover{background:#0056b3}.m{margin-top:20px;background:#1a1a1a;padding:20px;border-radius:8px;border:1px solid #333;line-height:1.6}h2,h3{margin-top:0;color:#fff}</style></head><body><h2>🚀 Proxy Downloader</h2><form action="/download" method="GET"><input name="url" placeholder="File URL" required><button type="submit">Download</button></form><div class="m"><h3>📊 Monitor</h3><div id="cpu">CPU: Loading...</div><div id="ram">RAM: Loading...</div><div id="disk">Disk: Loading...</div><div id="net">Net: Loading...</div><div id="total" style="margin-top:10px;border-top:1px solid #333;padding-top:10px">Total BW: Loading...</div></div><script>setInterval(()=>fetch('/status').then(r=>r.json()).then(d=>{document.getElementById('cpu').innerText='CPU: '+d.cpu+'%';document.getElementById('ram').innerText='RAM: '+d.ram+'%';document.getElementById('disk').innerText='Disk: '+d.disk+'%';document.getElementById('net').innerText='Net: '+d.net;document.getElementById('total').innerText='Total BW: '+d.total;}).catch(e=>console.log("Monitor offline")), 1000)</script></body></html>'''

p, pt = psutil.net_io_counters(), time.time()

def bw():
    global p, pt; n, t = psutil.net_io_counters(), time.time(); d = t - pt or 1
    s = (n.bytes_sent - p.bytes_sent) / d; r = (n.bytes_recv - p.bytes_recv) / d
    p, pt = n, t
    f = lambda b: f"{b/1024:.2f} KB/s" if b < 1024*1024 else f"{b/(1024*1024):.2f} MB/s"
    return f"↑ {f(s)} | ↓ {f(r)}"

def total():
    n = psutil.net_io_counters()
    f = lambda b: f"{b/(1024*1024):.2f} MB" if b < 1024*1024*1024 else f"{b/(1024*1024*1024):.2f} GB"
    return f"Sent: {f(n.bytes_sent)} | Recv: {f(n.bytes_recv)}"

def filename(r, u):
    cd = r.headers.get('Content-Disposition')
    if cd:
        m = re.search(r'filename="?(.*?)"?(;|$)', cd)
        if m: return m.group(1)
    name = os.path.basename(u.split('?')[0])
    return name if name else 'file'

@app.route('/')
def index(): return render_template_string(HTML)

@app.route('/download')
def download():
    u = request.args.get('url')
    if not u: return "Missing URL", 400
    h = {'Range': request.headers.get('Range')} if request.headers.get('Range') else {}
    try:
        r = requests.get(u, stream=True, headers=h, timeout=15)
        resp_h = {'Content-Disposition': f'attachment; filename="{filename(r, u)}"', 'Content-Type': r.headers.get('Content-Type', 'application/octet-stream')}
        # Crucial fix: Pass size headers to browser so it knows when the download is finished
        for head in ['Content-Length', 'Content-Range', 'Accept-Ranges']:
            if head in r.headers: resp_h[head] = r.headers[head]
        return Response(r.iter_content(chunk_size=8192), status=r.status_code, headers=resp_h)
    except Exception as e:
        return f"Error: {str(e)}", 500

@app.route('/status')
def status(): return jsonify({'cpu': psutil.cpu_percent(), 'ram': psutil.virtual_memory().percent, 'disk': psutil.disk_usage('/').percent, 'net': bw(), 'total': total()})

if __name__ == '__main__': app.run(host='0.0.0.0', port=8080)
PYTHON

echo "📝 Restarting Systemd Service..."
cat > /etc/systemd/system/proxy.service << 'SERVICE'
[Unit]
Description=Proxy
After=network.target

[Service]
ExecStart=/root/venv/bin/python /root/proxy.py
Restart=always

[Install]
WantedBy=multi-user.target
SERVICE

systemctl daemon-reload
systemctl enable proxy >/dev/null 2>&1
systemctl restart proxy

IP=$(curl -s ifconfig.me)
echo -e "\n============================================"
echo "✅ Python Proxy Downloader Restored!"
echo "🌐 Access your proxy at: http://$IP:8080"
echo "============================================"
EOF
bash setup.sh
